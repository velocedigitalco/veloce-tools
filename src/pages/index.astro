---
import BaseLayout from '../layouts/BaseLayout.astro';

const tools = [
  { href: '/tools/seo-meta-tag-generator', icon: '◎', title: 'SEO Meta Tag Generator', desc: 'Pixel-width meters, Google desktop, mobile and social previews, and copy-ready tags.' },
  { href: '/tools/qr-code-generator', icon: '⌁', title: 'QR Code Generator', desc: 'Links, WhatsApp, Wi-Fi and contacts. Style it, then export PNG or SVG.' },
  { href: '/tools/image-compressor', icon: '◌', title: 'Image Compressor', desc: 'Batch compress with presets, resize and a before/after slider. Download as ZIP.' },
  { href: '/tools/image-converter', icon: '◫', title: 'Image Converter', desc: 'Batch convert PNG, JPEG, WebP and AVIF. Resize, rotate and flip as you go.' },
  { href: '/tools/json-formatter', icon: '{ }', title: 'JSON Formatter', desc: 'Live validation, tree view, sort keys, minify and auto-fix common mistakes.' },
  { href: '/tools/password-generator', icon: '✦', title: 'Password Generator', desc: 'Random passwords, passphrases and PINs with real entropy-based strength.' },
  { href: '/tools/text-counter', icon: 'Aa', title: 'Text Counter', desc: 'Live counts, platform limits, keyword density and quick text clean-up.' },
  { href: '/tools/uuid-generator', icon: '#', title: 'UUID Generator', desc: 'v4, time-ordered v7 or nil. Bulk generate, any format, plus a validator.' },
  { href: '/tools/base64-encoder-decoder', icon: '↔', title: 'Base64 Tool', desc: 'Text, files and images. URL-safe mode, data URIs and previews.' },
  { href: '/tools/url-encoder-decoder', icon: '↗', title: 'URL Encoder', desc: 'Encode, decode, parse any link into parts, or build a query string.' },
  { href: '/tools/timestamp-converter', icon: '◷', title: 'Timestamp Converter', desc: 'Any timezone, auto-detects seconds to nanoseconds, converts whole lists.' },
  { href: '/tools/hash-generator', icon: '#', title: 'Hash Generator', desc: 'MD5 and SHA family at once, HMAC, file hashing and a hash verifier.' },
  { href: '/tools/color-converter', icon: '◉', title: 'Color Converter', desc: 'HEX, RGB, HSL, CMYK, contrast checks, palettes and a screen eyedropper.' },
];
---
<BaseLayout
  title="Veloce Tools — Useful tools. Beautifully simple."
  description="Free, private tools: QR codes, image compression, JSON formatting, password generator, hashing, SEO meta tags and more. No signup, runs in your browser."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Veloce Tools',
    description: 'Free, privacy-friendly digital tools for everyday work.',
  }}
>
  <script slot="head" src="/js/qrcode.js"></script>

  <!-- ===================== HERO ===================== -->
  <header class="hero">
    <div class="eyebrow">A product by Veloce Digital</div>
    <h1>Useful tools.<br /><span>Beautifully simple.</span></h1>
    <p class="hero-description">A growing collection of fast, focused digital tools designed to help you get things done — without the clutter.</p>
    <div class="hero-actions">
      <a href="#tools" class="primary-button">Explore Veloce Tools</a>
      <a href="#why" class="secondary-button">Why we built this</a>
    </div>
    <div class="trust">
      <span>Free to use</span>
      <span>Privacy-minded</span>
      <span>No unnecessary signup</span>
      <span>Built by Veloce Digital</span>
    </div>
  </header>

  <!-- ===================== FEATURED QR TOOL ===================== -->
  <section class="featured-section">
    <div class="featured">
      <div class="featured-copy">
        <small>Featured tool</small>
        <h2>Turn a link into a QR code.</h2>
        <p>Need to share something physical with a digital audience? Create a clean, high-quality QR code in seconds.</p>
        <div class="featured-tags">
          <span class="tag">Instant</span>
          <span class="tag">No account</span>
          <span class="tag">PNG download</span>
          <span class="tag">Free</span>
        </div>
        <a href="/tools/qr-code-generator" class="tool-open" style="margin-top:20px;">More options (size, color, error correction) <span>→</span></a>
      </div>
      <div class="qr-box">
        <div class="qr-input-row">
          <input id="qrInput" type="text" placeholder="Paste a URL or enter text..." />
          <button onclick="generateQR()">Create</button>
        </div>
        <div class="qr-result" id="qrResult">
          <canvas id="qrcode" width="460" height="460"></canvas>
          <button class="qr-download" onclick="downloadQR()">Download PNG</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== TOOLS ===================== -->
  <section class="section" id="tools">
    <div class="section-heading">
      <h2>One place.<br />Many useful things.</h2>
      <p>From working with images and text to handling developer utilities and SEO, Veloce Tools keeps the small jobs small. Every tool has its own page, so you can bookmark, share, or link straight to the one you need.</p>
    </div>

    <div class="tools-grid">
      {tools.map((tool, i) => (
        <a href={tool.href} style="text-decoration:none; color:inherit;">
          <div class="tool">
            <div class="tool-number">{String(i + 1).padStart(2, '0')}</div>
            <div class="tool-content">
              <div class="tool-icon">{tool.icon}</div>
              <h3>{tool.title}</h3>
              <p>{tool.desc}</p>
              <span class="tool-open">Open tool <span>→</span></span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ===================== WHY VELOCE ===================== -->
  <section class="value-section" id="why">
    <div class="value-inner">
      <h2>Software should help you.<br /><span>Not get in your way.</span></h2>
      <p>We built Veloce Tools around a simple idea: everyday utilities should be quick to understand, pleasant to use and respectful of the person using them.</p>
    </div>
  </section>

  <!-- ===================== BENEFITS ===================== -->
  <section class="benefits">
    <div class="benefit-grid">
      <div class="benefit">
        <h3>Fast by default.</h3>
        <p>Tools are designed to get you from input to result without unnecessary steps, dashboards or waiting.</p>
      </div>
      <div class="benefit">
        <h3>Privacy where it matters.</h3>
        <p>Whenever a tool can run locally, we keep the work in your browser instead of sending your content somewhere else.</p>
      </div>
      <div class="benefit">
        <h3>Built to stay simple.</h3>
        <p>No bloated interfaces. No artificial complexity. Just focused tools that solve the problem in front of you.</p>
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="cta" id="about">
    <h2>Find the tool.<br />Get the job done.</h2>
    <p>Veloce Tools — useful digital tools by Veloce Digital.</p>
    <a href="#tools" class="cta-button">Explore all tools</a>
  </section>

  <script slot="body-end" is:inline>
function generateQR() {
  const value = document.getElementById("qrInput").value.trim();
  if (!value) return;
  try {
    const q = VT.qrMatrix(value, "Q");
    VT.qrDraw(document.getElementById("qrcode"), q, 400, 30, "#111111", "#ffffff");
  } catch (e) { VT.toast("That is too long for a QR code"); return; }
  document.getElementById("qrResult").style.display = "block";
}

function downloadQR() {
  document.getElementById("qrcode").toBlob(function (b) { VT.download(b, "veloce-qr.png"); });
}

document.getElementById("qrInput").addEventListener("keydown", function (e) {
  if (e.key === "Enter") generateQR();
});
  </script>
</BaseLayout>
