---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tools } from '../data/tools';
const site = 'https://tools.velocedigital.co';
---
<BaseLayout
  title="Veloce Tools — Useful tools. Beautifully simple."
  description="Free, private tools: QR codes, image compression, JSON formatting, password generator, hashing, SEO meta tags and more. No signup, runs in your browser."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Veloce Tools',
    description: 'Free, privacy-friendly digital tools for everyday work.',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: tools.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.title, url: site + t.href })),
    },
  }}
>
  <!-- ===================== HERO ===================== -->
  <header class="hero hero--compact">
    <div class="eyebrow">A product by Veloce Digital</div>
    <h1>Useful tools.<br /><span>Beautifully simple.</span></h1>
    <p class="hero-description">Fast, focused tools for everyday work. Pick one below. Free, private, no signup.</p>
    <div class="trust">
      <span>Free to use</span>
      <span>Runs in your browser</span>
      <span>No unnecessary signup</span>
      <span>Built by Veloce Digital</span>
    </div>
  </header>

  <!-- ===================== ALL TOOLS ===================== -->
  <section class="section--grid" id="tools">
    <div class="grid-head">
      <span>{tools.length} free tools</span>
      <span>Listed alphabetically</span>
    </div>
    <div class="tools-grid">
      {tools.map((tool, i) => (
        <a href={tool.href} class="tool-link">
          <div class="tool">
            <div class="tool-number">{String(i + 1).padStart(2, '0')}</div>
            <div class="tool-content">
              <div class="tool-icon">{tool.icon}</div>
              <h3>{tool.title}</h3>
              <p>{tool.desc}</p>
              <span class="tool-open">Open tool <span>→</span></span>
            </div>
          </div>
        </a>
      ))}
      <a href="https://velocedigital.co/contact.html?utm_source=veloce_tools&utm_medium=suggest_tool" target="_blank" rel="noopener" class="tool-link tool-link--filler">
        <div class="tool tool--filler">
          <div class="tool-number">+</div>
          <div class="tool-content">
            <h3>Missing a tool?</h3>
            <p>Tell us what you would like to see next. We build the most requested ones first.</p>
            <span class="tool-open">Suggest a tool <span>→</span></span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- ===================== WHY VELOCE ===================== -->
  <section class="value-section" id="why">
    <div class="value-inner">
      <h2>Software should help you.<br /><span>Not get in your way.</span></h2>
      <p>We built Veloce Tools around a simple idea: everyday utilities should be quick to understand, pleasant to use and respectful of the person using them.</p>
    </div>
  </section>

  <!-- ===================== BENEFITS ===================== -->
  <section class="benefits">
    <div class="benefit-grid">
      <div class="benefit">
        <h3>Fast by default.</h3>
        <p>Tools are designed to get you from input to result without unnecessary steps, dashboards or waiting.</p>
      </div>
      <div class="benefit">
        <h3>Privacy where it matters.</h3>
        <p>Whenever a tool can run locally, we keep the work in your browser instead of sending your content somewhere else.</p>
      </div>
      <div class="benefit">
        <h3>Built to stay simple.</h3>
        <p>No bloated interfaces. No artificial complexity. Just focused tools that solve the problem in front of you.</p>
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="cta" id="about">
    <h2>Find the tool.<br />Get the job done.</h2>
    <p>Veloce Tools — useful digital tools by Veloce Digital.</p>
    <a href="#tools" class="cta-button">Explore all tools</a>
  </section>
</BaseLayout>
