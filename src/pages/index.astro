---
import BaseLayout from '../layouts/BaseLayout.astro';

const tools = [
  { href: '/tools/seo-meta-tag-generator', icon: '◎', title: 'SEO Meta Tag Generator', desc: 'Write an optimized title and description, and preview a live Google search result.' },
  { href: '/tools/qr-code-generator', icon: '⌁', title: 'QR Code Generator', desc: 'Create downloadable QR codes for URLs, text and everyday sharing.' },
  { href: '/tools/image-compressor', icon: '◌', title: 'Image Compressor', desc: 'Reduce image size directly in your browser before uploading or sharing.' },
  { href: '/tools/image-converter', icon: '◫', title: 'Image Converter', desc: 'Convert images between PNG, JPEG and WebP without installing anything.' },
  { href: '/tools/json-formatter', icon: '{ }', title: 'JSON Formatter', desc: 'Format, validate and make messy JSON readable in one click.' },
  { href: '/tools/password-generator', icon: '✦', title: 'Password Generator', desc: 'Generate strong passwords locally in your browser. Nothing needs to leave your device.' },
  { href: '/tools/text-counter', icon: 'Aa', title: 'Text Counter', desc: 'Count characters, words, lines and paragraphs instantly.' },
  { href: '/tools/uuid-generator', icon: '#', title: 'UUID Generator', desc: 'Generate random UUIDs instantly for development, testing and data work.' },
  { href: '/tools/base64-encoder-decoder', icon: '↔', title: 'Base64 Tool', desc: 'Encode and decode Base64 text quickly without sending your content to a server.' },
  { href: '/tools/url-encoder-decoder', icon: '↗', title: 'URL Encoder', desc: 'Encode or decode URLs and query strings without leaving your browser.' },
  { href: '/tools/timestamp-converter', icon: '◷', title: 'Timestamp Converter', desc: 'Convert Unix timestamps to readable dates and generate timestamps from dates.' },
  { href: '/tools/hash-generator', icon: '#', title: 'Hash Generator', desc: 'Generate SHA-1/256/384/512 hashes directly using your browser\'s Web Crypto API.' },
  { href: '/tools/color-converter', icon: '◉', title: 'Color Converter', desc: 'Convert HEX colors into RGB and HSL values and preview the result instantly.' },
];
---
<BaseLayout
  title="Veloce Tools — Useful tools. Beautifully simple."
  description="Veloce Tools is a collection of fast, privacy-friendly digital tools for everyday work: QR codes, image compression, JSON formatting, password generation, and more."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Veloce Tools',
    description: 'Free, privacy-friendly digital tools for everyday work.',
  }}
>
  <script slot="head" src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

  <!-- ===================== HERO ===================== -->
  <header class="hero">
    <div class="eyebrow">A product by Veloce Digital</div>
    <h1>Useful tools.<br /><span>Beautifully simple.</span></h1>
    <p class="hero-description">A growing collection of fast, focused digital tools designed to help you get things done — without the clutter.</p>
    <div class="hero-actions">
      <a href="#tools" class="primary-button">Explore Veloce Tools</a>
      <a href="#why" class="secondary-button">Why we built this</a>
    </div>
    <div class="trust">
      <span>Free to use</span>
      <span>Privacy-minded</span>
      <span>No unnecessary signup</span>
      <span>Built by Veloce Digital</span>
    </div>
  </header>

  <!-- ===================== FEATURED QR TOOL ===================== -->
  <section class="featured-section">
    <div class="featured">
      <div class="featured-copy">
        <small>Featured tool</small>
        <h2>Turn a link into a QR code.</h2>
        <p>Need to share something physical with a digital audience? Create a clean, high-quality QR code in seconds.</p>
        <div class="featured-tags">
          <span class="tag">Instant</span>
          <span class="tag">No account</span>
          <span class="tag">PNG download</span>
          <span class="tag">Free</span>
        </div>
        <a href="/tools/qr-code-generator" class="tool-open" style="margin-top:20px;">More options (size, color, error correction) <span>→</span></a>
      </div>
      <div class="qr-box">
        <div class="qr-input-row">
          <input id="qrInput" type="text" placeholder="Paste a URL or enter text..." />
          <button onclick="generateQR()">Create</button>
        </div>
        <div class="qr-result" id="qrResult">
          <div id="qrcode"></div>
          <button class="qr-download" onclick="downloadQR()">Download PNG</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== TOOLS ===================== -->
  <section class="section" id="tools">
    <div class="section-heading">
      <h2>One place.<br />Many useful things.</h2>
      <p>From working with images and text to handling developer utilities and SEO, Veloce Tools keeps the small jobs small. Every tool has its own page, so you can bookmark, share, or link straight to the one you need.</p>
    </div>

    <div class="tools-grid">
      {tools.map((tool, i) => (
        <a href={tool.href} style="text-decoration:none; color:inherit;">
          <div class="tool">
            <div class="tool-number">{String(i + 1).padStart(2, '0')}</div>
            <div class="tool-content">
              <div class="tool-icon">{tool.icon}</div>
              <h3>{tool.title}</h3>
              <p>{tool.desc}</p>
              <span class="tool-open">Open tool <span>→</span></span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ===================== WHY VELOCE ===================== -->
  <section class="value-section" id="why">
    <div class="value-inner">
      <h2>Software should help you.<br /><span>Not get in your way.</span></h2>
      <p>We built Veloce Tools around a simple idea: everyday utilities should be quick to understand, pleasant to use and respectful of the person using them.</p>
    </div>
  </section>

  <!-- ===================== BENEFITS ===================== -->
  <section class="benefits">
    <div class="benefit-grid">
      <div class="benefit">
        <h3>Fast by default.</h3>
        <p>Tools are designed to get you from input to result without unnecessary steps, dashboards or waiting.</p>
      </div>
      <div class="benefit">
        <h3>Privacy where it matters.</h3>
        <p>Whenever a tool can run locally, we keep the work in your browser instead of sending your content somewhere else.</p>
      </div>
      <div class="benefit">
        <h3>Built to stay simple.</h3>
        <p>No bloated interfaces. No artificial complexity. Just focused tools that solve the problem in front of you.</p>
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="cta" id="about">
    <h2>Find the tool.<br />Get the job done.</h2>
    <p>Veloce Tools — useful digital tools by Veloce Digital.</p>
    <a href="#tools" class="cta-button">Explore all tools</a>
  </section>

  <script slot="body-end" is:inline>
let qrInstance = null;

function generateQR() {
  const value = document.getElementById("qrInput").value.trim();
  if (!value) return;
  const container = document.getElementById("qrcode");
  container.innerHTML = "";
  qrInstance = new QRCode(container, {
    text: value, width: 200, height: 200,
    colorDark: "#111111", colorLight: "#ffffff",
    correctLevel: QRCode.CorrectLevel.H
  });
  document.getElementById("qrResult").style.display = "block";
}

function downloadQR() {
  const container = document.getElementById("qrcode");
  const canvas = container.querySelector("canvas");
  const image = container.querySelector("img");
  let url = "";
  if (canvas) url = canvas.toDataURL("image/png");
  else if (image) url = image.src;
  if (!url) return;
  const link = document.createElement("a");
  link.href = url;
  link.download = "veloce-qr.png";
  link.click();
}

document.getElementById("qrInput").addEventListener("keydown", function (e) {
  if (e.key === "Enter") generateQR();
});
  </script>
</BaseLayout>
