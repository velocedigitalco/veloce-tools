---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Veloce Tools — Useful tools. Beautifully simple."
  description="Veloce Tools is a collection of fast, privacy-friendly digital tools for everyday work: QR codes, image compression, JSON formatting, password generation, and more."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Veloce Tools',
    description: 'Free, privacy-friendly digital tools for everyday work.',
  }}
>
  <script slot="head" src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

  <!-- ===================== HERO ===================== -->
  <header class="hero">
    <div class="eyebrow">A product by Veloce Digital</div>
    <h1>Useful tools.<br /><span>Beautifully simple.</span></h1>
    <p class="hero-description">A growing collection of fast, focused digital tools designed to help you get things done — without the clutter.</p>
    <div class="hero-actions">
      <a href="#tools" class="primary-button">Explore Veloce Tools</a>
      <a href="#why" class="secondary-button">Why we built this</a>
    </div>
    <div class="trust">
      <span>Free to use</span>
      <span>Privacy-minded</span>
      <span>No unnecessary signup</span>
      <span>Built by Veloce Digital</span>
    </div>
  </header>

  <!-- ===================== FEATURED QR TOOL ===================== -->
  <section class="featured-section">
    <div class="featured">
      <div class="featured-copy">
        <small>Featured tool</small>
        <h2>Turn a link into a QR code.</h2>
        <p>Need to share something physical with a digital audience? Create a clean, high-quality QR code in seconds.</p>
        <div class="featured-tags">
          <span class="tag">Instant</span>
          <span class="tag">No account</span>
          <span class="tag">PNG download</span>
          <span class="tag">Free</span>
        </div>
      </div>
      <div class="qr-box">
        <div class="qr-input-row">
          <input id="qrInput" type="text" placeholder="Paste a URL or enter text..." />
          <button onclick="generateQR()">Create</button>
        </div>
        <div class="qr-result" id="qrResult">
          <div id="qrcode"></div>
          <button class="qr-download" onclick="downloadQR()">Download PNG</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== TOOLS ===================== -->
  <section class="section" id="tools">
    <div class="section-heading">
      <h2>One place.<br />Many useful things.</h2>
      <p>From working with images and text to handling developer utilities and SEO, Veloce Tools keeps the small jobs small.</p>
    </div>

    <div class="tools-grid">
      <a href="/tools/seo-meta-tag-generator" style="text-decoration:none; color:inherit;">
        <div class="tool">
          <div class="tool-number">01</div>
          <div class="tool-content">
            <div class="tool-icon">◎</div>
            <h3>SEO Meta Tag Generator</h3>
            <p>Write an optimized title and description, and preview a live Google search result.</p>
            <span class="tool-open">Open tool <span>→</span></span>
          </div>
        </div>
      </a>

      <div class="tool">
        <div class="tool-number">02</div>
        <div class="tool-content">
          <div class="tool-icon">⌁</div>
          <h3>QR Code Generator</h3>
          <p>Create downloadable QR codes for URLs, text and everyday sharing.</p>
          <a href="#" class="tool-open" onclick="openTool('qr');return false;">Open tool <span>→</span></a>
        </div>
      </div>

      <div class="tool">
        <div class="tool-number">03</div>
        <div class="tool-content">
          <div class="tool-icon">◌</div>
          <h3>Image Compressor</h3>
          <p>Reduce image size directly in your browser before uploading or sharing.</p>
          <a href="#" class="tool-open" onclick="openTool('compress');return false;">Open tool <span>→</span></a>
        </div>
      </div>

      <div class="tool">
        <div class="tool-number">04</div>
        <div class="tool-content">
          <div class="tool-icon">◫</div>
          <h3>Image Converter</h3>
          <p>Convert images between PNG, JPEG and WebP without installing anything.</p>
          <a href="#" class="tool-open" onclick="openTool('convert');return false;">Open tool <span>→</span></a>
        </div>
      </div>

      <div class="tool">
        <div class="tool-number">05</div>
        <div class="tool-content">
          <div class="tool-icon">{ }</div>
          <h3>JSON Formatter</h3>
          <p>Format, validate and make messy JSON readable in one click.</p>
          <a href="#" class="tool-open" onclick="openTool('json');return false;">Open tool <span>→</span></a>
        </div>
      </div>

      <div class="tool">
        <div class="tool-number">06</div>
        <div class="tool-content">
          <div class="tool-icon">✦</div>
          <h3>Password Generator</h3>
          <p>Generate strong passwords locally in your browser. Nothing needs to leave your device.</p>
          <a href="#" class="tool-open" onclick="openTool('password');return false;">Open tool <span>→</span></a>
        </div>
      </div>

      <div class="tool">
        <div class="tool-number">07</div>
        <div class="tool-content">
          <div class="tool-icon">Aa</div>
          <h3>Text Counter</h3>
          <p>Count characters, words, lines and paragraphs instantly.</p>
          <a href="#" class="tool-open" onclick="openTool('text');return false;">Open tool <span>→</span></a>
        </div>
      </div>

      <div class="tool">
        <div class="tool-number">08</div>
        <div class="tool-content">
          <div class="tool-icon">#</div>
          <h3>UUID Generator</h3>
          <p>Generate random UUIDs instantly for development, testing and data work.</p>
          <a href="#" class="tool-open" onclick="openTool('uuid');return false;">Open tool <span>→</span></a>
        </div>
      </div>

      <div class="tool">
        <div class="tool-number">09</div>
        <div class="tool-content">
          <div class="tool-icon">↔</div>
          <h3>Base64 Tool</h3>
          <p>Encode and decode Base64 text quickly without sending your content to a server.</p>
          <a href="#" class="tool-open" onclick="openTool('base64');return false;">Open tool <span>→</span></a>
        </div>
      </div>

      <div class="tool">
        <div class="tool-number">10</div>
        <div class="tool-content">
          <div class="tool-icon">↗</div>
          <h3>URL Encoder</h3>
          <p>Encode or decode URLs and query strings without leaving your browser.</p>
          <a href="#" class="tool-open" onclick="openTool('url');return false;">Open tool <span>→</span></a>
        </div>
      </div>

      <div class="tool">
        <div class="tool-number">11</div>
        <div class="tool-content">
          <div class="tool-icon">◷</div>
          <h3>Timestamp Converter</h3>
          <p>Convert Unix timestamps to readable dates and generate timestamps from dates.</p>
          <a href="#" class="tool-open" onclick="openTool('timestamp');return false;">Open tool <span>→</span></a>
        </div>
      </div>

      <div class="tool">
        <div class="tool-number">12</div>
        <div class="tool-content">
          <div class="tool-icon">#</div>
          <h3>Hash Generator</h3>
          <p>Generate SHA-256 hashes directly using your browser's Web Crypto API.</p>
          <a href="#" class="tool-open" onclick="openTool('hash');return false;">Open tool <span>→</span></a>
        </div>
      </div>

      <div class="tool">
        <div class="tool-number">13</div>
        <div class="tool-content">
          <div class="tool-icon">◉</div>
          <h3>Color Converter</h3>
          <p>Convert HEX colors into RGB values and preview the result instantly.</p>
          <a href="#" class="tool-open" onclick="openTool('color');return false;">Open tool <span>→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== WHY VELOCE ===================== -->
  <section class="value-section" id="why">
    <div class="value-inner">
      <h2>Software should help you.<br /><span>Not get in your way.</span></h2>
      <p>We built Veloce Tools around a simple idea: everyday utilities should be quick to understand, pleasant to use and respectful of the person using them.</p>
    </div>
  </section>

  <!-- ===================== BENEFITS ===================== -->
  <section class="benefits">
    <div class="benefit-grid">
      <div class="benefit">
        <h3>Fast by default.</h3>
        <p>Tools are designed to get you from input to result without unnecessary steps, dashboards or waiting.</p>
      </div>
      <div class="benefit">
        <h3>Privacy where it matters.</h3>
        <p>Whenever a tool can run locally, we keep the work in your browser instead of sending your content somewhere else.</p>
      </div>
      <div class="benefit">
        <h3>Built to stay simple.</h3>
        <p>No bloated interfaces. No artificial complexity. Just focused tools that solve the problem in front of you.</p>
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="cta" id="about">
    <h2>Find the tool.<br />Get the job done.</h2>
    <p>Veloce Tools — useful digital tools by Veloce Digital.</p>
    <a href="#tools" class="cta-button">Explore all tools</a>
  </section>

  <!-- ===================== TOOL MODAL ===================== -->
  <div class="modal" id="toolModal">
    <div class="modal-box">
      <div class="modal-top">
        <h2 id="modalTitle">Tool</h2>
        <button class="close" onclick="closeTool()">×</button>
      </div>
      <div class="tool-ui" id="toolUI"></div>
    </div>
  </div>

  <script slot="body-end" is:inline>
/* =========================================================
   QR GENERATOR
========================================================= */
let qrInstance = null;

function generateQR() {
  const value = document.getElementById("qrInput").value.trim();
  if (!value) return;
  const container = document.getElementById("qrcode");
  container.innerHTML = "";
  qrInstance = new QRCode(container, {
    text: value, width: 200, height: 200,
    colorDark: "#111111", colorLight: "#ffffff",
    correctLevel: QRCode.CorrectLevel.H
  });
  document.getElementById("qrResult").style.display = "block";
}

function downloadQR() {
  const container = document.getElementById("qrcode");
  const canvas = container.querySelector("canvas");
  const image = container.querySelector("img");
  let url = "";
  if (canvas) url = canvas.toDataURL("image/png");
  else if (image) url = image.src;
  if (!url) return;
  const link = document.createElement("a");
  link.href = url;
  link.download = "veloce-qr.png";
  link.click();
}

/* =========================================================
   MODAL
========================================================= */
const modal = document.getElementById("toolModal");
const modalTitle = document.getElementById("modalTitle");
const toolUI = document.getElementById("toolUI");

function openTool(tool) {
  modal.classList.add("active");
  const tools = {
    qr: {
      title: "QR Code Generator",
      html: `
        <input id="modalQRInput" placeholder="Enter a URL or text...">
        <button class="action" onclick="modalQR()">Generate QR</button>
        <div id="modalQR" style="margin-top:20px;text-align:center;"></div>
      `
    },
    compress: {
      title: "Image Compressor",
      html: `
        <div class="file-input"><input type="file" id="compressFile" accept="image/*"></div>
        <label>Quality</label>
        <input type="range" id="compressQuality" min="0.1" max="1" step="0.1" value="0.7">
        <button class="action" onclick="compressImage()">Compress image</button>
        <div id="compressResult" class="result-box"></div>
      `
    },
    convert: {
      title: "Image Converter",
      html: `
        <div class="file-input"><input type="file" id="convertFile" accept="image/*"></div>
        <select id="convertFormat">
          <option value="image/png">PNG</option>
          <option value="image/jpeg">JPEG</option>
          <option value="image/webp">WebP</option>
        </select>
        <button class="action" onclick="convertImage()">Convert image</button>
        <div id="convertResult" class="result-box"></div>
      `
    },
    json: {
      title: "JSON Formatter",
      html: `
        <textarea id="jsonInput" placeholder='Paste JSON here...'></textarea>
        <button class="action" onclick="formatJSON()">Format JSON</button>
        <div id="jsonResult" class="result-box"></div>
      `
    },
    password: {
      title: "Password Generator",
      html: `
        <label>Length</label>
        <input type="number" id="passwordLength" value="20" min="8" max="100">
        <button class="action" onclick="generatePassword()">Generate password</button>
        <div id="passwordResult" class="result-box"></div>
      `
    },
    text: {
      title: "Text Counter",
      html: `
        <textarea id="textInput" placeholder="Write or paste your text..." oninput="countText()"></textarea>
        <div id="textResult" class="result-box">Characters: 0
Words: 0
Lines: 0</div>
      `
    },
    uuid: {
      title: "UUID Generator",
      html: `
        <button class="action" onclick="generateUUID()">Generate UUID</button>
        <div id="uuidResult" class="result-box"></div>
      `
    },
    base64: {
      title: "Base64 Encoder / Decoder",
      html: `
        <textarea id="base64Input" placeholder="Enter text..."></textarea>
        <button class="action" onclick="encodeBase64()">Encode</button>
        <button class="action" onclick="decodeBase64()" style="margin-left:5px">Decode</button>
        <div id="base64Result" class="result-box"></div>
      `
    },
    url: {
      title: "URL Encoder / Decoder",
      html: `
        <textarea id="urlInput" placeholder="Enter URL or text..."></textarea>
        <button class="action" onclick="encodeURL()">Encode</button>
        <button class="action" onclick="decodeURL()" style="margin-left:5px">Decode</button>
        <div id="urlResult" class="result-box"></div>
      `
    },
    timestamp: {
      title: "Timestamp Converter",
      html: `
        <input id="timestampInput" placeholder="Unix timestamp...">
        <button class="action" onclick="timestampToDate()">Timestamp → Date</button>
        <button class="action" onclick="dateToTimestamp()" style="margin-left:5px">Current → Timestamp</button>
        <div id="timestampResult" class="result-box"></div>
      `
    },
    hash: {
      title: "SHA-256 Hash Generator",
      html: `
        <textarea id="hashInput" placeholder="Enter text to hash..."></textarea>
        <button class="action" onclick="generateHash()">Generate SHA-256</button>
        <div id="hashResult" class="result-box"></div>
      `
    },
    color: {
      title: "Color Converter",
      html: `
        <input id="colorInput" value="#111111" placeholder="#000000">
        <button class="action" onclick="convertColor()">Convert</button>
        <div id="colorPreview" class="color-preview"></div>
        <div id="colorResult" class="result-box"></div>
      `
    }
  };
  const selected = tools[tool];
  modalTitle.textContent = selected.title;
  toolUI.innerHTML = selected.html;
}

function closeTool() {
  modal.classList.remove("active");
}

modal.addEventListener("click", function (event) {
  if (event.target === modal) closeTool();
});

/* ---------------- MODAL QR ---------------- */
function modalQR() {
  const value = document.getElementById("modalQRInput").value.trim();
  if (!value) return;
  const target = document.getElementById("modalQR");
  target.innerHTML = "";
  new QRCode(target, { text: value, width: 220, height: 220, correctLevel: QRCode.CorrectLevel.H });
}

/* ---------------- IMAGE COMPRESSOR ---------------- */
function compressImage() {
  const file = document.getElementById("compressFile").files[0];
  if (!file) return;
  const quality = Number(document.getElementById("compressQuality").value);
  const reader = new FileReader();
  reader.onload = function (e) {
    const img = new Image();
    img.onload = function () {
      const canvas = document.createElement("canvas");
      canvas.width = img.width;
      canvas.height = img.height;
      canvas.getContext("2d").drawImage(img, 0, 0);
      canvas.toBlob(function (blob) {
        const url = URL.createObjectURL(blob);
        document.getElementById("compressResult").innerHTML =
          "Original: " + (file.size / 1024).toFixed(1) + " KB<br>" +
          "Compressed: " + (blob.size / 1024).toFixed(1) + " KB<br><br>" +
          '<a href="' + url + '" download="veloce-compressed.jpg" style="text-decoration:underline;">Download compressed image →</a>';
      }, "image/jpeg", quality);
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

/* ---------------- IMAGE CONVERTER ---------------- */
function convertImage() {
  const file = document.getElementById("convertFile").files[0];
  if (!file) return;
  const format = document.getElementById("convertFormat").value;
  const reader = new FileReader();
  reader.onload = function (e) {
    const img = new Image();
    img.onload = function () {
      const canvas = document.createElement("canvas");
      canvas.width = img.width;
      canvas.height = img.height;
      canvas.getContext("2d").drawImage(img, 0, 0);
      canvas.toBlob(function (blob) {
        const url = URL.createObjectURL(blob);
        const extension = format.split("/")[1];
        document.getElementById("convertResult").innerHTML =
          "Conversion complete.<br><br>" +
          '<a href="' + url + '" download="veloce-converted.' + extension + '" style="text-decoration:underline;">Download ' + extension.toUpperCase() + ' →</a>';
      }, format, .92);
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

/* ---------------- JSON ---------------- */
function formatJSON() {
  const input = document.getElementById("jsonInput").value;
  try {
    const parsed = JSON.parse(input);
    document.getElementById("jsonResult").textContent = JSON.stringify(parsed, null, 2);
  } catch (error) {
    document.getElementById("jsonResult").textContent = "Invalid JSON:\n" + error.message;
  }
}

/* ---------------- PASSWORD ---------------- */
function generatePassword() {
  const length = Number(document.getElementById("passwordLength").value);
  const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()-_=+";
  let password = "";
  const random = new Uint32Array(length);
  crypto.getRandomValues(random);
  for (let i = 0; i < length; i++) password += chars[random[i] % chars.length];
  document.getElementById("passwordResult").textContent = password;
}

/* ---------------- TEXT COUNTER ---------------- */
function countText() {
  const text = document.getElementById("textInput").value;
  const words = text.trim() ? text.trim().split(/\s+/).length : 0;
  const lines = text ? text.split("\n").length : 0;
  const paragraphs = text.trim() ? text.split(/\n\s*\n/).length : 0;
  document.getElementById("textResult").textContent =
    "Characters: " + text.length + "\n" +
    "Characters without spaces: " + text.replace(/\s/g, "").length + "\n" +
    "Words: " + words + "\n" +
    "Lines: " + lines + "\n" +
    "Paragraphs: " + paragraphs;
}

/* ---------------- UUID ---------------- */
function generateUUID() {
  let uuid;
  if (crypto.randomUUID) uuid = crypto.randomUUID();
  else {
    uuid = "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function (c) {
      const r = Math.random() * 16 | 0;
      const v = c === "x" ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  }
  document.getElementById("uuidResult").textContent = uuid;
}

/* ---------------- BASE64 ---------------- */
function encodeBase64() {
  const text = document.getElementById("base64Input").value;
  document.getElementById("base64Result").textContent = btoa(unescape(encodeURIComponent(text)));
}
function decodeBase64() {
  const text = document.getElementById("base64Input").value;
  try {
    document.getElementById("base64Result").textContent = decodeURIComponent(escape(atob(text)));
  } catch {
    document.getElementById("base64Result").textContent = "Invalid Base64.";
  }
}

/* ---------------- URL ---------------- */
function encodeURL() {
  const text = document.getElementById("urlInput").value;
  document.getElementById("urlResult").textContent = encodeURIComponent(text);
}
function decodeURL() {
  const text = document.getElementById("urlInput").value;
  try {
    document.getElementById("urlResult").textContent = decodeURIComponent(text);
  } catch {
    document.getElementById("urlResult").textContent = "Invalid encoded URL.";
  }
}

/* ---------------- TIMESTAMP ---------------- */
function timestampToDate() {
  const value = Number(document.getElementById("timestampInput").value);
  if (!Number.isFinite(value)) {
    document.getElementById("timestampResult").textContent = "Enter a valid Unix timestamp.";
    return;
  }
  const date = new Date(value < 100000000000 ? value * 1000 : value);
  document.getElementById("timestampResult").textContent = date.toString();
}
function dateToTimestamp() {
  document.getElementById("timestampResult").textContent = Math.floor(Date.now() / 1000);
}

/* ---------------- SHA-256 ---------------- */
async function generateHash() {
  const text = document.getElementById("hashInput").value;
  const data = new TextEncoder().encode(text);
  const hash = await crypto.subtle.digest("SHA-256", data);
  const result = Array.from(new Uint8Array(hash)).map(b => b.toString(16).padStart(2, "0")).join("");
  document.getElementById("hashResult").textContent = result;
}

/* ---------------- COLOR ---------------- */
function convertColor() {
  const hex = document.getElementById("colorInput").value.trim().replace("#", "");
  if (!/^[0-9a-fA-F]{6}$/.test(hex)) {
    document.getElementById("colorResult").textContent = "Enter a valid 6-character HEX color.";
    return;
  }
  const r = parseInt(hex.substring(0, 2), 16);
  const g = parseInt(hex.substring(2, 4), 16);
  const b = parseInt(hex.substring(4, 6), 16);
  document.getElementById("colorPreview").style.background = "#" + hex;
  document.getElementById("colorResult").textContent =
    "HEX: #" + hex.toUpperCase() + "\nRGB: rgb(" + r + ", " + g + ", " + b + ")";
}

/* ---------------- KEYBOARD ---------------- */
document.getElementById("qrInput").addEventListener("keydown", function (e) {
  if (e.key === "Enter") generateQR();
});
document.addEventListener("keydown", function (e) {
  if (e.key === "Escape") closeTool();
});
  </script>
</BaseLayout>
