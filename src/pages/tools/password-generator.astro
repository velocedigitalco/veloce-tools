---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  { q: 'Is this password actually random?', a: 'Yes — it uses the Web Crypto API (crypto.getRandomValues), which is cryptographically secure, not a simple Math.random() generator.' },
  { q: 'Is my generated password sent anywhere?', a: 'No. It\'s generated and displayed entirely in your browser and never transmitted or logged anywhere.' },
  { q: 'How long should my password be?', a: '16+ characters with a mix of character types is a solid baseline for most accounts. For anything protecting sensitive data, 20+ is better. Length matters more than complexity for resisting brute-force attacks.' },
];
---
<BaseLayout
  title="Free Secure Password Generator | Veloce Tools"
  description="Generate strong, random passwords using your browser's built-in cryptographic random number generator. Free, no signup, nothing leaves your device."
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Password Generator', applicationCategory: 'BrowserApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
    { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ]}
>
  <section class="section--tight">
    <div class="tool-hero">
      <span class="eyebrow">Free tool</span>
      <h1>Password Generator</h1>
      <p>Cryptographically random passwords, generated locally in your browser. Nothing is ever sent anywhere.</p>
    </div>

    <div style="max-width:600px;">
      <div class="slider-row">
        <div class="slider-top"><span>Length</span><strong id="lengthValue">20</strong></div>
        <input type="range" id="length" min="8" max="64" value="20" />
      </div>

      <div class="toggle-group">
        <label class="toggle-chip"><input type="checkbox" id="opt-upper" checked><span>Uppercase (A–Z)</span></label>
        <label class="toggle-chip"><input type="checkbox" id="opt-lower" checked><span>Lowercase (a–z)</span></label>
        <label class="toggle-chip"><input type="checkbox" id="opt-numbers" checked><span>Numbers (0–9)</span></label>
        <label class="toggle-chip"><input type="checkbox" id="opt-symbols" checked><span>Symbols (!@#$...)</span></label>
      </div>

      <div class="result-row">
        <div class="result-box" id="passwordResult" style="font-family:ui-monospace, SFMono-Regular, Menlo, monospace; font-size:17px; word-break:break-all;"></div>
        <button type="button" class="copy-btn" id="copyBtn">Copy</button>
      </div>
      <div class="strength-meter"><div id="strengthBar"></div></div>
      <p class="strength-label" id="strengthLabel"></p>

      <button type="button" class="primary-button" id="regenerateBtn" style="width:100%; border:none; margin-top:18px; text-align:center;">Generate new password</button>
    </div>
  </section>

  <section class="section--tight prose">
    <span class="eyebrow">Why it matters</span>
    <h2>Weak passwords are still the #1 cause of account breaches.</h2>
    <p>Reused and predictable passwords are the easiest way into an account — credential-stuffing attacks try leaked password lists against thousands of sites per second. A unique, random password per account (stored in a password manager, not memorized) closes that door almost entirely.</p>
  </section>

  <section class="section--tight">
    <span class="eyebrow">FAQ</span>
    <h2 style="font-size:32px; letter-spacing:-1.5px; margin-bottom:20px;">Common questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="cta">
    <h2>Worried about your website's security, not just your passwords?</h2>
    <p>Veloce Digital can audit and harden your site's security setup.</p>
    <a href="https://velocedigital.co/security-scanning.html?utm_source=veloce_tools&utm_medium=password_generator" target="_blank" rel="noopener" class="cta-button">See Security Services</a>
  </section>

  <script slot="body-end" is:inline>
(function () {
  var lengthInput = document.getElementById('length');
  var lengthValue = document.getElementById('lengthValue');
  var resultBox = document.getElementById('passwordResult');
  var copyBtn = document.getElementById('copyBtn');
  var strengthBar = document.getElementById('strengthBar');
  var strengthLabel = document.getElementById('strengthLabel');
  var opts = {
    upper: document.getElementById('opt-upper'),
    lower: document.getElementById('opt-lower'),
    numbers: document.getElementById('opt-numbers'),
    symbols: document.getElementById('opt-symbols'),
  };
  var sets = {
    upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    lower: 'abcdefghijklmnopqrstuvwxyz',
    numbers: '0123456789',
    symbols: '!@#$%^&*()-_=+[]{}'
  };

  function generate() {
    var length = Number(lengthInput.value);
    lengthValue.textContent = length;
    var chars = '';
    Object.keys(opts).forEach(function (key) { if (opts[key].checked) chars += sets[key]; });
    if (!chars) chars = sets.lower;

    var password = '';
    var random = new Uint32Array(length);
    crypto.getRandomValues(random);
    for (var i = 0; i < length; i++) password += chars[random[i] % chars.length];
    resultBox.textContent = password;

    var typesUsed = Object.keys(opts).filter(function (key) { return opts[key].checked; }).length;
    var score = Math.min(100, (length / 32) * 60 + typesUsed * 10);
    strengthBar.style.width = score + '%';
    if (score < 40) { strengthBar.style.background = '#b3261e'; strengthLabel.textContent = 'Weak — increase length or add character types'; }
    else if (score < 75) { strengthBar.style.background = '#b8790f'; strengthLabel.textContent = 'Reasonable'; }
    else { strengthBar.style.background = '#1f7a4d'; strengthLabel.textContent = 'Strong'; }
  }

  lengthInput.addEventListener('input', generate);
  Object.keys(opts).forEach(function (key) { opts[key].addEventListener('change', generate); });
  document.getElementById('regenerateBtn').addEventListener('click', generate);
  copyBtn.addEventListener('click', function () {
    navigator.clipboard.writeText(resultBox.textContent).then(function () {
      copyBtn.classList.add('is-copied');
      copyBtn.textContent = 'Copied!';
      setTimeout(function () { copyBtn.classList.remove('is-copied'); copyBtn.textContent = 'Copy'; }, 1500);
    });
  });

  generate();
})();
  </script>
</BaseLayout>
