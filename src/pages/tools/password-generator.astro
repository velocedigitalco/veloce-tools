---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  { q: 'Is this password actually random?', a: 'Yes — it uses the Web Crypto API (crypto.getRandomValues), which is cryptographically secure, not a simple Math.random() generator.' },
  { q: 'Is my generated password sent anywhere?', a: 'No. It\'s generated and displayed entirely in your browser and never transmitted or logged anywhere.' },
  { q: 'How long should my password be?', a: '16+ characters with a mix of character types is a solid baseline for most accounts. For anything protecting sensitive data, 20+ is better. Length matters more than complexity for resisting brute-force attacks.' },
];
---
<BaseLayout
  title="Free Secure Password Generator | Veloce Tools"
  description="Generate strong random passwords, passphrases or PINs with your browser's secure random generator. Bulk mode, no look-alikes. Nothing leaves your device."
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Password Generator', applicationCategory: 'BrowserApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
    { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ]}
>
  <section class="section--tight">
<div class="tool-hero">
      <span class="eyebrow">Free tool</span>
      <h1>Password Generator</h1>
      <p>Random passwords, memorable passphrases, or PINs. Generated with your browser's cryptographic random generator and never sent anywhere.</p>
    </div>

    <div class="tool-columns">
      <div>
        <div class="tabs" id="modeTabs">
          <button type="button" class="active" data-t="random">Random password</button>
          <button type="button" data-t="phrase">Passphrase</button>
          <button type="button" data-t="pin">PIN</button>
        </div>
        <div id="panes">
          <div data-pane="random">
            <div class="slider-row">
              <div class="slider-top"><span>Length</span><strong id="lenV">20</strong></div>
              <input type="range" id="len" min="4" max="128" value="20" />
            </div>
            <div class="toggle-group">
              <label class="toggle-chip"><input type="checkbox" id="oU" checked><span>A-Z</span></label>
              <label class="toggle-chip"><input type="checkbox" id="oL" checked><span>a-z</span></label>
              <label class="toggle-chip"><input type="checkbox" id="oN" checked><span>0-9</span></label>
              <label class="toggle-chip"><input type="checkbox" id="oS" checked><span>Symbols</span></label>
            </div>
            <label class="check"><input type="checkbox" id="oAmb" /> Avoid look-alike characters (I, l, 1, O, 0)</label>
            <label class="check"><input type="checkbox" id="oRep" /> No repeated characters</label>
            <details class="adv">
              <summary>Custom symbols</summary>
              <div class="field" style="margin-bottom:0;">
                <label for="sym">Symbols to use</label>
                <input id="sym" type="text" value="!@#$%^&*()-_=+[]:;,.?" />
              </div>
            </details>
          </div>
          <div data-pane="phrase" class="hidden">
            <div class="slider-row">
              <div class="slider-top"><span>Number of words</span><strong id="wV">6</strong></div>
              <input type="range" id="words" min="3" max="12" value="6" />
            </div>
            <div class="field">
              <label for="sep">Separator</label>
              <select id="sep"><option value="-">Hyphen ( - )</option><option value=".">Dot ( . )</option><option value="_">Underscore ( _ )</option><option value=" ">Space</option><option value="">None</option></select>
            </div>
            <label class="check"><input type="checkbox" id="cap" checked /> Capitalize each word</label>
            <label class="check"><input type="checkbox" id="num" /> Add a number at the end</label>
          </div>
          <div data-pane="pin" class="hidden">
            <div class="slider-row">
              <div class="slider-top"><span>Digits</span><strong id="dV">6</strong></div>
              <input type="range" id="digits" min="4" max="16" value="6" />
            </div>
            <label class="check"><input type="checkbox" id="obv" checked /> Avoid obvious PINs (0000, 1234, 4321)</label>
          </div>
        </div>
        <div class="field" style="margin-top:12px;">
          <label for="count">How many to generate</label>
          <select id="count"><option value="1">1</option><option value="5">5</option><option value="10">10</option><option value="20">20</option></select>
        </div>
      </div>

      <div class="tool-columns__sticky">
        <p class="tool-label">Your password</p>
        <div class="panel" id="results" style="padding:8px 18px;"></div>
        <div class="strength-meter"><div id="bar"></div></div>
        <p class="strength-label" id="strength"></p>
        <div class="actions">
          <button type="button" class="primary-button" id="regen" style="border:none;">Generate again</button>
          <button type="button" class="secondary-button" id="copyAll">Copy all</button>
          <button type="button" class="secondary-button" id="dl">Download .txt</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight prose">
    <span class="eyebrow">Why it matters</span>
    <h2>Weak passwords are still the #1 cause of account breaches.</h2>
    <p>Reused and predictable passwords are the easiest way into an account — credential-stuffing attacks try leaked password lists against thousands of sites per second. A unique, random password per account (stored in a password manager, not memorized) closes that door almost entirely.</p>
  </section>

  <section class="section--tight">
    <span class="eyebrow">FAQ</span>
    <h2 style="font-size:32px; letter-spacing:-1.5px; margin-bottom:20px;">Common questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="cta">
    <h2>Worried about your website's security, not just your passwords?</h2>
    <p>Veloce Digital can audit and harden your site's security setup.</p>
    <a href="https://velocedigital.co/security-scanning.html?utm_source=veloce_tools&utm_medium=password_generator" target="_blank" rel="noopener" class="cta-button">See Security Services</a>
  </section>

  <script slot="body-end" is:inline>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var WORDS = ('able acid aged also area army away baby back ball band bank base bath bear beat beef bell belt bend best bike bird blue boat body bold bone book boom boot born boss both bowl bulk burn bush busy cafe cage cake calm camp card care cart case cash cast cave cell chef chip city clam clay clip club coal coat code coin cold cook cool cope copy cord core corn cost crew crop cube cure dark dart data dawn deal dear deck deep deer desk dial dice diet dish dive dock dome door dose dove down draw drop drum duck duel dust duty each earn ease east easy edge emit epic even exit face fact fade fair fall farm fast fate fear feed feel fern file fill film find fine fire firm fish five flag flat flip flow foam fold folk food foot ford fork form fort four free frog fuel full fund gain game gate gear gift girl give glad glow glue goal gold golf good gown grab gray grid grin grip grow gulf hair half hall hand hang hard harp hawk heal heap hear heat help herb hero hide high hill hint hold hole home hood hope horn host hour huge hunt hurt idea inch iron isle item jade jazz jean jest join joke jump june jury keen keep kelp kind king kiss kite knee knot know lace lack lake lamp land lane lark last late lava lawn lead leaf lean left lend lens life lift lily lime line link lion list live load loaf lock loft logo long loop lord lost loud love luck lump lung lynx made mail main make mall many maps mare mark mask mass mast mate maze meal meat melt menu mesh mild milk mind mine mint miss mist moat mode mole moon more moss most move much myth').split(' ');
  var mode = 'random', last = [];

  function rnd(n) { var a = new Uint32Array(1), lim = Math.floor(4294967296 / n) * n; do { crypto.getRandomValues(a); } while (a[0] >= lim); return a[0] % n; }
  function pick(s) { return s[rnd(s.length)]; }
  function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var j = rnd(i + 1), t = a[i]; a[i] = a[j]; a[j] = t; } return a; }

  function genRandom() {
    var amb = $('oAmb').checked, rep = $('oRep').checked, len = Number($('len').value);
    var rm = function (s) { return amb ? s.replace(/[Il1O0|]/g, '') : s; };
    var sets = [];
    if ($('oU').checked) sets.push(rm('ABCDEFGHIJKLMNOPQRSTUVWXYZ'));
    if ($('oL').checked) sets.push(rm('abcdefghijklmnopqrstuvwxyz'));
    if ($('oN').checked) sets.push(rm('0123456789'));
    if ($('oS').checked && $('sym').value) sets.push(rm($('sym').value));
    if (!sets.length) sets.push(rm('abcdefghijklmnopqrstuvwxyz'));
    var pool = sets.join(''), uniq = Array.from(new Set(pool.split(''))).join('');
    if (rep && len > uniq.length) len = uniq.length;
    var used = {}, out = [];
    function draw(src) { var c, g = 0; do { c = pick(src); g++; } while (rep && used[c] && g < 500); used[c] = 1; return c; }
    sets.forEach(function (s) { if (out.length < len) out.push(draw(s)); });
    while (out.length < len) out.push(draw(uniq));
    return { text: shuffle(out).join(''), bits: len * Math.log2(uniq.length) };
  }
  function genPhrase() {
    var n = Number($('words').value), parts = [];
    for (var i = 0; i < n; i++) { var w = pick(WORDS); parts.push($('cap').checked ? w.charAt(0).toUpperCase() + w.slice(1) : w); }
    var t = parts.join($('sep').value), bits = n * Math.log2(WORDS.length);
    if ($('num').checked) { t += $('sep').value + rnd(100); bits += Math.log2(100); }
    return { text: t, bits: bits };
  }
  function genPin() {
    var n = Number($('digits').value), t, tries = 0;
    do {
      t = ''; for (var i = 0; i < n; i++) t += rnd(10); tries++;
    } while ($('obv').checked && tries < 50 && (/^(\d)\1+$/.test(t) || '01234567890123456789'.indexOf(t) > -1 || '98765432109876543210'.indexOf(t) > -1));
    return { text: t, bits: n * Math.log2(10) };
  }
  function human(sec) {
    if (sec < 1) return 'instantly'; if (sec < 60) return Math.round(sec) + ' seconds';
    if (sec < 3600) return Math.round(sec / 60) + ' minutes'; if (sec < 86400) return Math.round(sec / 3600) + ' hours';
    if (sec < 31557600) return Math.round(sec / 86400) + ' days';
    var y = sec / 31557600;
    if (y < 1000) return Math.round(y) + ' years'; if (y < 1e6) return Math.round(y / 1000) + ' thousand years';
    if (y < 1e9) return Math.round(y / 1e6) + ' million years'; if (y < 1e12) return Math.round(y / 1e9) + ' billion years';
    return 'longer than the age of the universe';
  }

  function gen() {
    $('lenV').textContent = $('len').value; $('wV').textContent = $('words').value; $('dV').textContent = $('digits').value;
    var n = Number($('count').value), list = [], f = mode === 'random' ? genRandom : mode === 'phrase' ? genPhrase : genPin, bits = 0;
    for (var i = 0; i < n; i++) { var r = f(); list.push(r.text); bits = r.bits; }
    last = list;
    $('results').innerHTML = list.map(function (p, i) {
      return '<div class="rowline"><div class="val" style="font-size:' + (n === 1 ? 17 : 14) + 'px;">' + VT.esc(p) + '</div><button type="button" class="mini" data-i="' + i + '">Copy</button></div>';
    }).join('');
    var pct = Math.min(100, bits / 100 * 100), label, color;
    if (bits < 28) { label = 'Very weak'; color = '#b3261e'; } else if (bits < 36) { label = 'Weak'; color = '#d9541e'; }
    else if (bits < 60) { label = 'Reasonable'; color = '#b8790f'; } else if (bits < 80) { label = 'Strong'; color = '#4a8f3c'; } else { label = 'Very strong'; color = '#1f7a4d'; }
    $('bar').style.width = pct + '%'; $('bar').style.background = color;
    $('strength').textContent = label + ' \u00b7 ' + Math.round(bits) + ' bits of entropy \u00b7 an offline attacker making 10 billion guesses per second would need about ' + human(Math.pow(2, bits - 1) / 1e10) + ' on average.';
  }

  VT.tabs($('modeTabs'), $('panes'), function (t) { mode = t; gen(); });
  ['len', 'words', 'digits'].forEach(function (id) { $(id).addEventListener('input', gen); });
  ['oU', 'oL', 'oN', 'oS', 'oAmb', 'oRep', 'sym', 'sep', 'cap', 'num', 'obv', 'count'].forEach(function (id) { $(id).addEventListener('change', gen); });
  $('sym').addEventListener('input', gen);
  $('regen').addEventListener('click', gen);
  $('results').addEventListener('click', function (e) { var b = e.target.closest('[data-i]'); if (b) VT.copy(last[Number(b.getAttribute('data-i'))], 'Password copied'); });
  $('copyAll').addEventListener('click', function () { VT.copy(last.join('\n')); });
  $('dl').addEventListener('click', function () { VT.download(last.join('\n'), 'passwords.txt'); });
  gen();
})();
  </script>
</BaseLayout>
