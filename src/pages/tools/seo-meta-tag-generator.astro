---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'How long should a meta title be?',
    a: 'Aim for 50–60 characters. Google measures by pixel width, not character count, but that range is the safest bet against truncation on most searches.',
  },
  {
    q: 'How long should a meta description be?',
    a: 'Keep it to 150–160 characters. Google sometimes rewrites your description in the results anyway, but a good one still improves click-through when it is shown.',
  },
  {
    q: 'Do meta keywords still matter?',
    a: 'No. Google has ignored the meta keywords tag for search ranking for years, which is why this tool does not generate one.',
  },
  {
    q: 'Will this actually improve my Google ranking?',
    a: 'A well-written title and description improve click-through rate, which is a positive signal — but they are one small piece of SEO, not a fix for deeper technical or content issues.',
  },
];
---
<BaseLayout
  title="Free SEO Meta Tag Generator with Google Preview | Veloce Tools"
  description="Generate meta title, description, Open Graph and Twitter tags with pixel-width meters and live Google desktop, mobile and social previews. Free, no signup."
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'SEO Meta Tag Generator',
      applicationCategory: 'BrowserApplication',
      operatingSystem: 'Any',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description: 'Free browser-based tool to generate SEO meta title, description, and Open Graph tags with a live Google search preview.',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <section class="section--tight">
<div class="tool-hero">
      <span class="eyebrow">Free tool</span>
      <h1>SEO Meta Tag Generator</h1>
      <p>Write your title and description with live pixel-width meters, preview how they look on Google (desktop and mobile) and on social shares, then copy the finished tags.</p>
    </div>

    <div class="actions" style="margin-top:0;">
      <button type="button" class="mini" id="example">Load example</button>
      <button type="button" class="mini" id="reset">Reset</button>
    </div>

    <div class="mtg">
      <div>
        <div class="field">
          <label for="title">Page title</label>
          <input id="title" type="text" maxlength="160" placeholder="e.g. Affordable Web Design in Lahore | Veloce Digital" />
          <div class="progress" id="tBar"><div></div></div>
          <span class="count" id="tCount">0 chars &middot; 0 / 600 px</span>
        </div>
        <div class="field">
          <label for="desc">Meta description</label>
          <textarea id="desc" maxlength="400" placeholder="A one- to two-sentence summary, written to make someone want to click." style="min-height:96px;"></textarea>
          <div class="progress" id="dBar"><div></div></div>
          <span class="count" id="dCount">0 chars &middot; 0 / 920 px</span>
        </div>
        <div class="field">
          <label for="url">Page URL</label>
          <input id="url" type="text" placeholder="https://example.com/page" />
        </div>
        <div class="opt-grid">
          <div class="field"><label for="site">Site name <span class="optional">(optional)</span></label><input id="site" type="text" placeholder="Veloce Digital" /></div>
          <div class="field"><label for="tw">X / Twitter handle <span class="optional">(optional)</span></label><input id="tw" type="text" placeholder="@velocedigital" /></div>
        </div>
        <div class="field"><label for="img">Share image URL <span class="optional">(optional, 1200x630 works best)</span></label><input id="img" type="text" placeholder="https://example.com/share.jpg" /></div>

        <details class="adv">
          <summary>Include in output</summary>
          <div>
            <label class="check"><input type="checkbox" id="iCanon" checked /> Canonical link</label>
            <label class="check"><input type="checkbox" id="iOg" checked /> Open Graph (Facebook, WhatsApp, LinkedIn)</label>
            <label class="check"><input type="checkbox" id="iTw" checked /> Twitter / X card</label>
            <div class="field" style="margin-top:12px;margin-bottom:0;">
              <label for="robots">Robots directive</label>
              <select id="robots"><option value="">Default (omit tag)</option><option value="index, follow">index, follow</option><option value="noindex, follow">noindex, follow</option><option value="noindex, nofollow">noindex, nofollow</option></select>
            </div>
          </div>
        </details>
      </div>

      <div class="mtg__preview-col">
        <div class="tabs" id="pvTabs">
          <button type="button" class="active" data-t="gd">Google desktop</button>
          <button type="button" data-t="gm">Google mobile</button>
          <button type="button" data-t="so">Social share</button>
        </div>
        <div id="pvPanes">
          <div data-pane="gd"><div class="serp" id="serpD">
            <div class="serp__site"><span class="serp__favicon" aria-hidden="true"></span><div><p class="serp__sitename" id="sName">yoursite.com</p><p class="serp__url" id="sUrl">https://example.com/page</p></div></div>
            <p class="serp__title" id="sTitle">Your page title will appear here</p>
            <p class="serp__desc" id="sDesc">Your meta description will appear here once you start typing.</p>
          </div></div>
          <div data-pane="gm" class="hidden"><div class="serp mobile" id="serpM">
            <div class="serp__site"><span class="serp__favicon" aria-hidden="true"></span><div><p class="serp__sitename" id="mName">yoursite.com</p><p class="serp__url" id="mUrl">https://example.com/page</p></div></div>
            <p class="serp__title" id="mTitle" style="white-space:normal;">Your page title will appear here</p>
            <p class="serp__desc" id="mDesc">Your meta description will appear here once you start typing.</p>
          </div></div>
          <div data-pane="so" class="hidden"><div class="social">
            <div class="img" id="soImg">No share image</div>
            <div class="meta"><div class="d" id="soDom">yoursite.com</div><div class="t" id="soTitle">Your page title</div><div class="s" id="soDesc">Your description</div></div>
          </div></div>
        </div>
        <div id="advice" class="hint" style="margin:12px 0;"></div>

        <p class="mtg__label" style="margin-top:20px;">Generated HTML</p>
        <pre class="mtg__code" id="code"><code id="codeText">&lt;!-- Fill in the fields to generate tags --&gt;</code></pre>
        <div class="actions">
          <button type="button" class="primary-button" id="copy" style="border:none;">Copy HTML</button>
          <button type="button" class="secondary-button" id="dl">Download .html</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight prose">
    <span class="eyebrow">How it works</span>
    <h2>Four fields, one paste.</h2>
    <ol>
      <li><strong>Write your title</strong> — the headline in the Google results tab. Keep your main keyword near the front.</li>
      <li><strong>Write your description</strong> — the pitch under the title. Say what the page is and why someone should click.</li>
      <li><strong>Add the URL and site name</strong> — these fill the canonical link and the Open Graph tags used by WhatsApp, Facebook, and LinkedIn link previews.</li>
      <li><strong>Copy the HTML</strong> and paste it inside the <code>&lt;head&gt;</code> of that page.</li>
    </ol>
  </section>

  <section class="section--tight prose">
    <span class="eyebrow">Why it matters</span>
    <h2>Your meta tags are your ad in the search results.</h2>
    <p>Google doesn't rank a page higher just because the description is well-written — but it's often the only thing standing between a search and a click. A vague or truncated title loses clicks to a competitor with a clearer one, even at the same ranking position. Missing Open Graph tags mean a shared link shows up blank on WhatsApp or Facebook.</p>
    <p>This tool handles the formatting correctly — the right limits, the right tag names, matching Open Graph and Twitter Card data — so you can focus on writing copy people actually want to click.</p>
  </section>

  <section class="section--tight">
    <span class="eyebrow">FAQ</span>
    <h2 style="font-size:32px; letter-spacing:-1.5px; margin-bottom:20px;">Common questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>
            {f.q}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="cta">
    <h2>Want your whole site's SEO handled?</h2>
    <p>Meta tags are one small piece. Veloce Digital's SEO team covers technical audits, content, and rankings end to end.</p>
    <a href="https://velocedigital.co/seo.html?utm_source=veloce_tools&utm_medium=meta_tag_generator" target="_blank" rel="noopener" class="cta-button">See SEO Services</a>
  </section>

  <style>
    .mtg{ display:grid; grid-template-columns:1fr 1fr; gap:50px; align-items:start; margin-top:50px; }
    @media (max-width:900px){ .mtg{ grid-template-columns:1fr; } }
    .mtg__preview-col{ position:sticky; top:90px; }
    .mtg__label{ font-size:12px; font-weight:600; color:#999; margin:0 0 10px; text-transform:uppercase; letter-spacing:.05em; }
    .mtg__preview-col .mtg__label:not(:first-child){ margin-top:24px; }
    .serp{ background:#fff; border-radius:14px; padding:18px 20px; font-family:arial, sans-serif; border:1px solid #e3e3e3; }
    .serp__site{ display:flex; align-items:center; gap:.7rem; }
    .serp__favicon{ width:26px; height:26px; border-radius:50%; flex:none; background:#111; }
    .serp__sitename{ margin:0; font-size:.85rem; color:#202124; font-weight:500; }
    .serp__url{ margin:0; font-size:.78rem; color:#4d5156; word-break:break-all; }
    .serp__title{ margin:.35rem 0 .2rem; color:#1a0dab; font-size:1.15rem; line-height:1.3; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .serp__desc{ margin:0; color:#4d5156; font-size:.88rem; line-height:1.5; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .mtg__code{ background:#111; border-radius:12px; padding:16px 18px; font-size:12.5px; line-height:1.6; color:rgba(255,255,255,.85); overflow-x:auto; white-space:pre; max-height:16rem; margin:0 0 16px; font-family:ui-monospace, SFMono-Regular, Menlo, monospace; }
  </style>

  <script slot="body-end" is:inline>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var ctx = document.createElement('canvas').getContext('2d');
  function px(text, font) { ctx.font = font; return Math.round(ctx.measureText(text).width); }
  function host(u) { try { return new URL(/^[a-z]+:/i.test(u) ? u : 'https://' + u).hostname.replace(/^www\./, ''); } catch (e) { return u ? u.replace(/^https?:\/\//, '').split('/')[0] : 'yoursite.com'; } }
  function meter(bar, w, limit) { var el = bar.firstElementChild; el.style.width = Math.min(100, w / limit * 100) + '%'; bar.classList.toggle('over', w > limit); }

  function render() {
    var t = $('title').value.trim(), d = $('desc').value.trim(), u = $('url').value.trim(), s = $('site').value.trim(), tw = $('tw').value.trim().replace(/^@?/, '@'), im = $('img').value.trim();
    var tw_ = px(t, '20px arial'), dw = px(d, '14px arial');
    $('tCount').textContent = t.length + ' chars \u00b7 ' + tw_ + ' / 600 px'; $('dCount').textContent = d.length + ' chars \u00b7 ' + dw + ' / 920 px';
    meter($('tBar'), tw_, 600); meter($('dBar'), dw, 920);
    $('tCount').classList.toggle('is-bad', tw_ > 600); $('dCount').classList.toggle('is-bad', dw > 920);
    var T = t || 'Your page title will appear here', D = d || 'Your meta description will appear here once you start typing.', H = host(u), U = u || 'https://example.com/page';
    $('sTitle').textContent = T; $('mTitle').textContent = T; $('sDesc').textContent = D; $('mDesc').textContent = D;
    $('sName').textContent = H; $('mName').textContent = H; $('sUrl').textContent = U; $('mUrl').textContent = U;
    $('soTitle').textContent = t || 'Your page title'; $('soDesc').textContent = d || 'Your description'; $('soDom').textContent = H;
    var soImg = $('soImg'); if (im) { var i = new Image(); i.onload = function () { soImg.style.backgroundImage = 'url("' + im.replace(/"/g, '%22') + '")'; soImg.textContent = ''; }; i.onerror = function () { soImg.style.backgroundImage = ''; soImg.textContent = 'Image could not be loaded'; }; i.src = im; } else { soImg.style.backgroundImage = ''; soImg.textContent = 'No share image'; }

    var tips = []; if (t && tw_ > 600) tips.push('Your title is wider than Google usually shows (about 600 px) and will be cut off.'); if (t && t.length < 25) tips.push('A longer title (30-60 characters) usually performs better.');
    if (d && dw > 920) tips.push('Your description is likely to be truncated in results.'); if (d && d.length < 70) tips.push('Descriptions around 120-160 characters tend to work best.');
    if (u && !/^https?:\/\//i.test(u)) tips.push('Use a full URL starting with https:// for canonical and Open Graph tags.');
    $('advice').innerHTML = tips.length ? tips.map(function (x) { return '&bull; ' + VT.esc(x); }).join('<br>') : (t || d ? 'Looking good.' : '');

    var e = VT.esc, L = [];
    if (t) L.push('<title>' + e(t) + '</title>'); if (d) L.push('<meta name="description" content="' + e(d) + '">');
    if ($('robots').value) L.push('<meta name="robots" content="' + e($('robots').value) + '">');
    if ($('iCanon').checked && u) L.push('<link rel="canonical" href="' + e(u) + '">');
    if ($('iOg').checked) { L.push('', '<!-- Open Graph -->', '<meta property="og:type" content="website">'); if (t) L.push('<meta property="og:title" content="' + e(t) + '">'); if (d) L.push('<meta property="og:description" content="' + e(d) + '">'); if (u) L.push('<meta property="og:url" content="' + e(u) + '">'); if (s) L.push('<meta property="og:site_name" content="' + e(s) + '">'); if (im) L.push('<meta property="og:image" content="' + e(im) + '">'); }
    if ($('iTw').checked) { L.push('', '<!-- Twitter / X -->', '<meta name="twitter:card" content="' + (im ? 'summary_large_image' : 'summary') + '">'); if (t) L.push('<meta name="twitter:title" content="' + e(t) + '">'); if (d) L.push('<meta name="twitter:description" content="' + e(d) + '">'); if (im) L.push('<meta name="twitter:image" content="' + e(im) + '">'); if (tw.length > 1) L.push('<meta name="twitter:site" content="' + e(tw) + '">'); }
    var out = L.filter(function (x, i, a) { return x !== '' || (i > 0 && a[i - 1] !== ''); }).join('\n').trim();
    $('codeText').textContent = (t || d) ? out : '<!-- Fill in the fields to generate tags -->';
    window.__mtgOut = (t || d) ? out : '';
  }
  ['title', 'desc', 'url', 'site', 'tw', 'img'].forEach(function (id) { $(id).addEventListener('input', render); });
  ['iCanon', 'iOg', 'iTw', 'robots'].forEach(function (id) { $(id).addEventListener('change', render); });
  VT.tabs($('pvTabs'), $('pvPanes'));
  $('example').addEventListener('click', function () {
    $('title').value = 'Affordable Web Design in Lahore | Veloce Digital'; $('desc').value = 'Custom websites, SEO and digital marketing for businesses across Pakistan. Built fast, priced fairly, and designed to bring in customers.';
    $('url').value = 'https://velocedigital.co/'; $('site').value = 'Veloce Digital'; $('tw').value = '@velocedigital'; render();
  });
  $('reset').addEventListener('click', function () { ['title', 'desc', 'url', 'site', 'tw', 'img'].forEach(function (id) { $(id).value = ''; }); $('robots').value = ''; render(); });
  $('copy').addEventListener('click', function () { if (window.__mtgOut) VT.copy(window.__mtgOut, 'Meta tags copied'); else VT.toast('Fill in a title or description first'); });
  $('dl').addEventListener('click', function () { if (window.__mtgOut) VT.download('<!-- Paste inside <head> -->\n' + window.__mtgOut + '\n', 'meta-tags.html', 'text/html'); else VT.toast('Nothing to download yet'); });
  render();
})();
  </script>
</BaseLayout>
