---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  { q: 'Does this upload my image anywhere?', a: 'No. Compression happens entirely in your browser using the Canvas API. Your image never leaves your device.' },
  { q: 'What quality setting should I use?', a: '70–80% is a good default: a large reduction in file size with barely visible quality loss. The presets cover the common cases: Web for general use, Smallest file for thumbnails, High quality for portfolios, and WhatsApp / email for quick sharing.' },
  { q: 'Why did my transparent PNG get a white background?', a: 'JPEG doesn\'t support transparency, so transparent areas are filled with a background color (white by default, changeable under More options). To keep transparency, choose WebP or PNG as the output format. PNG is lossless, so it only gets smaller if you also reduce the dimensions.' },
];
---
<BaseLayout
  title="Free Image Compressor: Reduce File Size Online | Veloce Tools"
  description="Compress images in bulk in your browser. Choose a preset, resize, pick JPEG or WebP, compare with a slider and download a ZIP. Free, no upload."
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Image Compressor', applicationCategory: 'BrowserApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
    { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ]}
>
  <section class="section--tight">
<div class="tool-hero">
      <span class="eyebrow">Free tool</span>
      <h1>Image Compressor</h1>
      <p>Compress one image or fifty. Pick a preset or fine-tune quality, size and format, compare before and after, then download. Everything happens in your browser.</p>
    </div>

    <div class="tool-columns">
      <div>
        <label class="dropzone" id="dz">
          <input type="file" multiple accept="image/*" />
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 16V4m0 0 5 5m-5-5-5 5M5 20h14" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="dz-title">Drop images here, click to browse, or paste with Ctrl+V</span>
          <span class="dz-sub">Batch supported &middot; JPEG, PNG, WebP, GIF, BMP</span>
        </label>

        <p class="tool-label">Preset</p>
        <div class="chips" id="presets">
          <button type="button" class="chip active" data-p="web">Web (balanced)</button>
          <button type="button" class="chip" data-p="small">Smallest file</button>
          <button type="button" class="chip" data-p="high">High quality</button>
          <button type="button" class="chip" data-p="chat">WhatsApp / email</button>
        </div>

        <div class="slider-row">
          <div class="slider-top"><span>Quality</span><strong id="qv">75%</strong></div>
          <input type="range" id="q" min="10" max="100" step="1" value="75" />
        </div>

        <div class="opt-grid">
          <div class="field">
            <label for="fmt">Output format</label>
            <select id="fmt">
              <option value="image/jpeg">JPEG (works everywhere)</option>
              <option value="image/webp">WebP (smaller)</option>
              <option value="image/png">PNG (lossless, resize only)</option>
            </select>
          </div>
          <div class="field">
            <label for="max">Max width / height</label>
            <select id="max">
              <option value="0">Keep original size</option>
              <option value="3840">3840 px (4K)</option>
              <option value="2560">2560 px</option>
              <option value="1920" selected>1920 px (Full HD)</option>
              <option value="1600">1600 px</option>
              <option value="1280">1280 px (HD)</option>
              <option value="1080">1080 px</option>
              <option value="800">800 px</option>
              <option value="640">640 px</option>
              <option value="custom">Custom...</option>
            </select>
          </div>
        </div>
        <div class="field hidden" id="customWrap">
          <label for="customMax">Custom max size (px)</label>
          <input type="number" id="customMax" min="16" max="10000" value="1000" />
        </div>

        <details class="adv">
          <summary>More options</summary>
          <div>
            <div class="field">
              <label for="bg">Background for transparent areas (JPEG)</label>
              <input type="color" id="bg" value="#ffffff" style="height:44px;padding:4px;" />
            </div>
            <label class="check"><input type="checkbox" id="suffix" checked /> Add "-compressed" to file names</label>
            <p class="hint">Metadata such as EXIF location and camera data is removed automatically during compression.</p>
          </div>
        </details>
      </div>

      <div>
        <div class="stat-grid" id="stats" style="display:none;">
          <div class="stat"><b id="sFiles">0</b><span>Files</span></div>
          <div class="stat"><b id="sBefore">0</b><span>Before</span></div>
          <div class="stat"><b id="sAfter">0</b><span>After</span></div>
          <div class="stat"><b id="sSaved" class="save">0%</b><span>Saved</span></div>
        </div>
        <div id="cmpWrap" class="hidden" style="margin-bottom:16px;">
          <p class="tool-label">Compare &middot; drag across the image</p>
          <div class="cmp" id="cmp">
            <img id="cmpB" alt="Original" />
            <div class="top"><img id="cmpA" alt="Compressed" /></div>
            <div class="line"></div>
            <span class="lb" style="left:10px;">Compressed</span>
            <span class="lb" style="right:10px;">Original</span>
            <input type="range" id="cmpR" min="0" max="100" value="50" aria-label="Comparison slider" />
          </div>
        </div>
        <div id="list"><div class="out" style="color:#999;">Your compressed images will appear here.</div></div>
        <div class="actions" id="acts" style="display:none;">
          <button type="button" class="primary-button" id="zipBtn" style="border:none;">Download all (ZIP)</button>
          <button type="button" class="secondary-button" id="clearBtn">Clear all</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight prose">
    <span class="eyebrow">Why it matters</span>
    <h2>Page speed depends on image weight more than anything else.</h2>
    <p>Images are usually the single biggest contributor to page load time. A photo straight off a phone camera can be 4–8MB — compressing it to a web-appropriate size often cuts that by 80–90% with no visible quality loss, which means faster pages, lower bounce rates, and better Core Web Vitals scores.</p>
  </section>

  <section class="section--tight">
    <span class="eyebrow">FAQ</span>
    <h2 style="font-size:32px; letter-spacing:-1.5px; margin-bottom:20px;">Common questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="cta">
    <h2>Want your whole site optimized, not just one image?</h2>
    <p>Veloce Digital's website care plans handle image optimization, caching, and speed as an ongoing service.</p>
    <a href="https://velocedigital.co/website-care-plans.html?utm_source=veloce_tools&utm_medium=image_compressor" target="_blank" rel="noopener" class="cta-button">See Care Plans</a>
  </section>

  <script slot="body-end" is:inline>
(function () {
  var PRESETS = {
    web:   { q: 75, fmt: 'image/jpeg', max: '1920' },
    small: { q: 50, fmt: 'image/webp', max: '1280' },
    high:  { q: 90, fmt: 'image/jpeg', max: '3840' },
    chat:  { q: 60, fmt: 'image/jpeg', max: '1080' }
  };
  var $ = function (id) { return document.getElementById(id); };
  var items = [], sel = null, token = 0;

  function maxVal() { return $('max').value === 'custom' ? Number($('customMax').value) || 0 : Number($('max').value); }
  function opts() {
    return { q: Number($('q').value) / 100, fmt: $('fmt').value, max: maxVal(), bg: $('bg').value };
  }
  function setPreset(p) {
    var c = PRESETS[p]; if (!c) return;
    $('q').value = c.q; $('fmt').value = c.fmt; $('max').value = c.max;
    $('customWrap').classList.add('hidden'); $('qv').textContent = c.q + '%';
    document.querySelectorAll('#presets .chip').forEach(function (b) { b.classList.toggle('active', b.getAttribute('data-p') === p); });
  }
  function custom() { document.querySelectorAll('#presets .chip').forEach(function (b) { b.classList.remove('active'); }); }

  document.querySelectorAll('#presets .chip').forEach(function (b) {
    b.addEventListener('click', function () { setPreset(b.getAttribute('data-p')); run(); });
  });
  $('q').addEventListener('input', function () { $('qv').textContent = $('q').value + '%'; custom(); run(); });
  $('fmt').addEventListener('change', function () { custom(); run(); });
  $('max').addEventListener('change', function () { $('customWrap').classList.toggle('hidden', $('max').value !== 'custom'); custom(); run(); });
  $('customMax').addEventListener('input', function () { run(); });
  $('bg').addEventListener('input', function () { run(); });
  $('suffix').addEventListener('change', render);

  function addFiles(files) {
    files = files.filter(function (f) { return f.type.indexOf('image/') === 0; });
    if (!files.length) { VT.toast('Please choose image files'); return; }
    Promise.all(files.map(function (f) {
      return VT.loadImage(f).then(function (r) { return { file: f, img: r.img, url: r.url, res: null }; }).catch(function () { VT.toast('Could not read ' + f.name); return null; });
    })).then(function (list) {
      list.filter(Boolean).forEach(function (it) { items.push(it); });
      if (!sel && items.length) sel = items[0];
      run();
    });
  }
  VT.drop($('dz'), addFiles, { paste: true, accept: 'image/' });

  function outName(it) {
    var base = it.file.name.replace(/\.[^.]+$/, '');
    return base + ($('suffix').checked ? '-compressed' : '') + '.' + VT.EXT[$('fmt').value];
  }

  var run = VT.debounce(function () {
    var my = ++token, o = opts();
    if (!items.length) { render(); return; }
    Promise.all(items.map(function (it) {
      return VT.processImage(it.img, o).then(function (r) { if (my === token) it.res = r; });
    })).then(function () { if (my === token) render(); });
  }, 120);

  function render() {
    var list = $('list');
    if (!items.length) {
      list.innerHTML = '<div class="out" style="color:#999;">Your compressed images will appear here.</div>';
      $('stats').style.display = 'none'; $('acts').style.display = 'none'; $('cmpWrap').classList.add('hidden'); return;
    }
    var before = 0, after = 0;
    list.innerHTML = '';
    items.forEach(function (it, i) {
      if (!it.res) return;
      before += it.file.size; after += it.res.blob.size;
      var pct = Math.round((1 - it.res.blob.size / it.file.size) * 100);
      var div = document.createElement('div');
      div.className = 'file-item' + (it === sel ? ' sel' : '');
      div.innerHTML = '<img src="' + it.url + '" alt="" />' +
        '<div><div class="nm">' + VT.esc(it.file.name) + '</div><div class="sub">' + VT.bytes(it.file.size) + ' &rarr; ' + VT.bytes(it.res.blob.size) +
        ' &middot; ' + it.res.w + '&times;' + it.res.h + ' &middot; ' +
        (pct > 0 ? '<span class="save">-' + pct + '%</span>' : '<span class="warnc">already well optimized</span>') + '</div></div>' +
        '<div class="btn-row" style="margin:0;"><button class="mini dark" data-dl="' + i + '">Download</button><button class="mini" data-rm="' + i + '">Remove</button></div>';
      div.querySelector('img').addEventListener('click', function () { sel = it; render(); });
      list.appendChild(div);
    });
    $('stats').style.display = 'grid';
    $('sFiles').textContent = items.length;
    $('sBefore').textContent = VT.bytes(before);
    $('sAfter').textContent = VT.bytes(after);
    var tot = before ? Math.max(0, Math.round((1 - after / before) * 100)) : 0;
    $('sSaved').textContent = tot + '%';
    $('acts').style.display = 'flex';
    $('zipBtn').style.display = items.length > 1 ? '' : 'none';
    if (sel && sel.res) {
      if (sel._u) URL.revokeObjectURL(sel._u);
      sel._u = URL.createObjectURL(sel.res.blob);
      $('cmpB').src = sel.url; $('cmpA').src = sel._u; $('cmpWrap').classList.remove('hidden');
    }
  }

  $('list').addEventListener('click', function (e) {
    var d = e.target.closest('[data-dl]'), r = e.target.closest('[data-rm]');
    if (d) { var it = items[Number(d.getAttribute('data-dl'))]; VT.download(it.res.blob, outName(it)); }
    if (r) { var k = Number(r.getAttribute('data-rm')); var gone = items.splice(k, 1)[0]; URL.revokeObjectURL(gone.url); if (sel === gone) sel = items[0] || null; render(); }
  });
  $('zipBtn').addEventListener('click', function () {
    var seen = {};
    VT.zipBlobs(items.map(function (it) {
      var n = outName(it); if (seen[n]) { n = n.replace(/(\.[^.]+)$/, '-' + seen[n]++ + '$1'); } else seen[n] = 1;
      return { name: n, blob: it.res.blob };
    })).then(function (z) { VT.download(z, 'veloce-compressed-images.zip'); });
  });
  $('clearBtn').addEventListener('click', function () { items.forEach(function (i) { URL.revokeObjectURL(i.url); }); items = []; sel = null; render(); });
  $('cmpR').addEventListener('input', function () { $('cmp').style.setProperty('--r', (100 - Number($('cmpR').value)) + '%'); });
  $('cmp').style.setProperty('--r', '50%');
})();
  </script>
</BaseLayout>
