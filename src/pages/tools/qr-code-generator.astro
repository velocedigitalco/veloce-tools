---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  { q: 'Will this QR code expire?', a: 'No. The QR code is generated entirely in your browser and encodes your text or link directly — there\'s no server tracking it, so it never expires or stops working.' },
  { q: 'What size should I use for printing?', a: 'For print (flyers, posters, packaging), use the 400px option or larger and keep the code at least 2.5cm / 1 inch wide so phone cameras can focus on it easily.' },
  { q: 'Why isn\'t my QR code scanning?', a: 'Low contrast between the code and background is the most common cause. Keep the foreground dark and background light, and leave a white margin (quiet zone) around the code when placing it in a design.' },
];
---
<BaseLayout
  title="Free QR Code Generator: WhatsApp, Wi-Fi, Link | Veloce Tools"
  description="Create QR codes for links, WhatsApp, Wi-Fi, contacts and email. Style them, then download PNG or print-ready SVG. Free, no signup, runs in your browser."
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'QR Code Generator', applicationCategory: 'BrowserApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
    { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ]}
>
  <script slot="head" src="/js/qrcode.js"></script>

  <section class="section--tight">
<div class="tool-hero">
      <span class="eyebrow">Free tool</span>
      <h1>QR Code Generator</h1>
      <p>Create QR codes for links, WhatsApp chats, Wi-Fi, contacts and more. Style them, then download as PNG or print-ready SVG. Generated entirely in your browser.</p>
    </div>

    <div class="tool-columns">
      <div>
        <div class="tabs" id="typeTabs">
          <button type="button" class="active" data-t="url">Link</button>
          <button type="button" data-t="text">Text</button>
          <button type="button" data-t="wa">WhatsApp</button>
          <button type="button" data-t="wifi">Wi-Fi</button>
          <button type="button" data-t="email">Email</button>
          <button type="button" data-t="tel">Phone</button>
          <button type="button" data-t="vcard">Contact</button>
        </div>
        <div id="panes">
          <div data-pane="url"><div class="field"><label for="fUrl">Website link</label><input id="fUrl" type="text" placeholder="https://example.com" /></div></div>
          <div data-pane="text" class="hidden"><div class="field"><label for="fText">Text</label><textarea id="fText" placeholder="Any text, up to a few hundred characters" style="min-height:110px;"></textarea></div></div>
          <div data-pane="wa" class="hidden">
            <div class="field"><label for="waNum">WhatsApp number with country code</label><input id="waNum" type="text" placeholder="923001234567" /></div>
            <div class="field"><label for="waMsg">Pre-filled message <span class="optional">(optional)</span></label><textarea id="waMsg" placeholder="Hi! I found you through your QR code." style="min-height:80px;"></textarea></div>
          </div>
          <div data-pane="wifi" class="hidden">
            <div class="field"><label for="wSsid">Network name (SSID)</label><input id="wSsid" type="text" /></div>
            <div class="opt-grid">
              <div class="field"><label for="wPass">Password</label><input id="wPass" type="text" /></div>
              <div class="field"><label for="wEnc">Security</label><select id="wEnc"><option value="WPA">WPA / WPA2 / WPA3</option><option value="WEP">WEP</option><option value="nopass">No password</option></select></div>
            </div>
            <label class="check"><input type="checkbox" id="wHid" /> Hidden network</label>
          </div>
          <div data-pane="email" class="hidden">
            <div class="field"><label for="eTo">Email address</label><input id="eTo" type="text" placeholder="hello@example.com" /></div>
            <div class="field"><label for="eSub">Subject <span class="optional">(optional)</span></label><input id="eSub" type="text" /></div>
            <div class="field"><label for="eBody">Message <span class="optional">(optional)</span></label><textarea id="eBody" style="min-height:80px;"></textarea></div>
          </div>
          <div data-pane="tel" class="hidden"><div class="field"><label for="tNum">Phone number</label><input id="tNum" type="text" placeholder="+923001234567" /></div></div>
          <div data-pane="vcard" class="hidden">
            <div class="opt-grid">
              <div class="field"><label for="vName">Full name</label><input id="vName" type="text" /></div>
              <div class="field"><label for="vOrg">Company</label><input id="vOrg" type="text" /></div>
              <div class="field"><label for="vTel">Phone</label><input id="vTel" type="text" /></div>
              <div class="field"><label for="vMail">Email</label><input id="vMail" type="text" /></div>
            </div>
            <div class="field" style="margin-top:14px;"><label for="vUrl">Website</label><input id="vUrl" type="text" /></div>
          </div>
        </div>

        <details class="adv" open>
          <summary>Style</summary>
          <div>
            <p class="tool-label">Color theme</p>
            <div class="chips" id="themes">
              <button type="button" class="chip active" data-fg="#111111" data-bg="#ffffff">Classic</button>
              <button type="button" class="chip" data-fg="#4438ca" data-bg="#ffffff">Indigo</button>
              <button type="button" class="chip" data-fg="#14532d" data-bg="#ecfdf5">Forest</button>
              <button type="button" class="chip" data-fg="#9f1239" data-bg="#fff1f2">Crimson</button>
              <button type="button" class="chip" data-fg="#c2410c" data-bg="#fff7ed">Sunset</button>
            </div>
            <div class="opt-grid">
              <div class="field"><label for="fg">Code color</label><input id="fg" type="color" value="#111111" style="height:44px;padding:4px;" /></div>
              <div class="field"><label for="bg">Background</label><input id="bg" type="color" value="#ffffff" style="height:44px;padding:4px;" /></div>
            </div>
            <div class="slider-row" style="margin-top:16px;">
              <div class="slider-top"><span>Size</span><strong id="sizeV">320 px</strong></div>
              <input type="range" id="size" min="128" max="1024" step="16" value="320" />
            </div>
            <div class="slider-row">
              <div class="slider-top"><span>Margin around the code</span><strong id="marV">24 px</strong></div>
              <input type="range" id="margin" min="0" max="80" step="4" value="24" />
            </div>
            <div class="field" style="margin-bottom:0;">
              <label for="lvl">Error correction</label>
              <select id="lvl"><option value="L">Low (7%) - simplest pattern</option><option value="M">Medium (15%)</option><option value="Q" selected>Quartile (25%)</option><option value="H">High (30%) - survives damage</option></select>
            </div>
          </div>
        </details>
      </div>

      <div class="tool-columns__sticky">
        <p class="tool-label">Preview</p>
        <div class="panel" style="display:flex;justify-content:center;padding:26px;background:#fafafa;">
          <canvas id="qrOut" width="320" height="320" style="max-width:100%;height:auto;border-radius:6px;"></canvas>
        </div>
        <div id="warn" class="hint" style="min-height:20px;"></div>
        <div class="actions">
          <button type="button" class="primary-button" id="dlPng" style="border:none;">Download PNG</button>
          <button type="button" class="secondary-button" id="dlSvg">Download SVG</button>
          <button type="button" class="secondary-button" id="cpImg">Copy image</button>
        </div>
        <p class="hint">Always test-scan your code with a phone before printing. SVG is best for print because it stays sharp at any size.</p>
      </div>
    </div>
  </section>

  <section class="section--tight prose">
    <span class="eyebrow">Why it matters</span>
    <h2>A QR code is a bridge from print to screen.</h2>
    <p>Menus, business cards, packaging, posters — anywhere someone sees your business offline, a QR code gets them to your site, a form, or a WhatsApp chat in one scan. Higher error correction levels keep the code scannable even if it gets slightly scratched, scuffed, or printed small, at the cost of a denser-looking pattern.</p>
  </section>

  <section class="section--tight">
    <span class="eyebrow">FAQ</span>
    <h2 style="font-size:32px; letter-spacing:-1.5px; margin-bottom:20px;">Common questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="cta">
    <h2>Need a whole website, not just a QR code?</h2>
    <p>Veloce Digital designs and builds sites that the QR code actually lands on.</p>
    <a href="https://velocedigital.co/website-development.html?utm_source=veloce_tools&utm_medium=qr_generator" target="_blank" rel="noopener" class="cta-button">See Web Design Services</a>
  </section>

  <script slot="body-end" is:inline>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var type = 'url', inst = null, ok = false;

  function content() {
    switch (type) {
      case 'url': var u = $('fUrl').value.trim(); if (!u) return ''; return /^[a-z][a-z0-9+.-]*:/i.test(u) ? u : 'https://' + u;
      case 'text': return $('fText').value;
      case 'wa': var n = $('waNum').value.replace(/\D/g, ''); if (!n) return ''; var m = $('waMsg').value.trim(); return 'https://wa.me/' + n + (m ? '?text=' + encodeURIComponent(m) : '');
      case 'wifi': if (!$('wSsid').value) return ''; var e = function (s) { return s.replace(/([\\;,:"])/g, '\\$1'); }, enc = $('wEnc').value;
        return 'WIFI:T:' + enc + ';S:' + e($('wSsid').value) + ';' + (enc === 'nopass' ? '' : 'P:' + e($('wPass').value) + ';') + ($('wHid').checked ? 'H:true;' : '') + ';';
      case 'email': if (!$('eTo').value.trim()) return ''; var q = []; if ($('eSub').value) q.push('subject=' + encodeURIComponent($('eSub').value)); if ($('eBody').value) q.push('body=' + encodeURIComponent($('eBody').value));
        return 'mailto:' + $('eTo').value.trim() + (q.length ? '?' + q.join('&') : '');
      case 'tel': return $('tNum').value.trim() ? 'tel:' + $('tNum').value.replace(/[^\d+]/g, '') : '';
      case 'vcard': if (!$('vName').value.trim()) return '';
        return ['BEGIN:VCARD', 'VERSION:3.0', 'N:;' + $('vName').value.trim() + ';;;', 'FN:' + $('vName').value.trim(), $('vOrg').value && 'ORG:' + $('vOrg').value, $('vTel').value && 'TEL:' + $('vTel').value,
          $('vMail').value && 'EMAIL:' + $('vMail').value, $('vUrl').value && 'URL:' + $('vUrl').value, 'END:VCARD'].filter(Boolean).join('\n');
    }
    return '';
  }
  function lumOf(h) { var v = [1, 3, 5].map(function (i) { var x = parseInt(h.substr(i, 2), 16) / 255; return x <= .03928 ? x / 12.92 : Math.pow((x + .055) / 1.055, 2.4); }); return .2126 * v[0] + .7152 * v[1] + .0722 * v[2]; }

  function render() {
    var size = Number($('size').value), pad = Number($('margin').value), out = $('qrOut'), ctx = out.getContext('2d'), txt = content();
    $('sizeV').textContent = size + ' px'; $('marV').textContent = pad + ' px';
    out.width = out.height = size + pad * 2; ctx.fillStyle = $('bg').value; ctx.fillRect(0, 0, out.width, out.height);
    ok = false; inst = null;
    var l1 = lumOf($('fg').value), l2 = lumOf($('bg').value), cr = (Math.max(l1, l2) + .05) / (Math.min(l1, l2) + .05);
    var msg = cr < 3 ? 'Low contrast between code and background. Many scanners will fail to read this.' : (l1 > l2 ? 'Light code on a dark background is unreliable on some scanners. Test before printing.' : '');
    if (!txt) { ctx.fillStyle = '#bbb'; ctx.font = '14px sans-serif'; ctx.textAlign = 'center'; ctx.fillText('Fill in the form to generate your code', out.width / 2, out.height / 2); $('warn').textContent = ''; return; }
    try {
      inst = VT.qrMatrix(txt, $('lvl').value); VT.qrDraw(out, inst, size, pad, $('fg').value, $('bg').value); ok = true; $('warn').textContent = msg;
    } catch (e) { ctx.fillStyle = '#b3261e'; ctx.font = '14px sans-serif'; ctx.textAlign = 'center'; ctx.fillText('Too much data for this error-correction level', out.width / 2, out.height / 2); $('warn').textContent = 'Try shorter content or a lower error-correction level.'; }
  }
  var go = VT.debounce(render, 120);

  VT.tabs($('typeTabs'), $('panes'), function (t) { type = t; render(); });
  document.querySelectorAll('#panes input, #panes textarea, #panes select').forEach(function (el) { el.addEventListener('input', go); el.addEventListener('change', go); });
  ['fg', 'bg', 'size', 'margin', 'lvl'].forEach(function (id) { $(id).addEventListener('input', function () { if (id === 'fg' || id === 'bg') document.querySelectorAll('#themes .chip').forEach(function (x) { x.classList.remove('active'); }); go(); }); });
  document.querySelectorAll('#themes .chip').forEach(function (b) {
    b.addEventListener('click', function () {
      $('fg').value = b.getAttribute('data-fg'); $('bg').value = b.getAttribute('data-bg');
      document.querySelectorAll('#themes .chip').forEach(function (x) { x.classList.toggle('active', x === b); }); render();
    });
  });

  function need() { if (!ok) { VT.toast('Fill in the form first'); return false; } return true; }
  $('dlPng').addEventListener('click', function () { if (need()) $('qrOut').toBlob(function (b) { VT.download(b, 'veloce-qr.png'); }); });
  $('cpImg').addEventListener('click', function () {
    if (!need()) return;
    $('qrOut').toBlob(function (b) {
      try { navigator.clipboard.write([new ClipboardItem({ 'image/png': b })]).then(function () { VT.toast('Image copied'); }, function () { VT.toast('Copy blocked. Use Download instead'); }); }
      catch (e) { VT.toast('Your browser cannot copy images. Use Download'); }
    });
  });
  $('dlSvg').addEventListener('click', function () {
    if (!need()) return;
    try {
      var q = inst, n = q.getModuleCount(), size = Number($('size').value), pad = Number($('margin').value), cell = size / n, pm = pad / cell, d = '';
      for (var r = 0; r < n; r++) for (var c = 0; c < n; c++) if (q.isDark(r, c)) d += 'M' + (c + pm) + ' ' + (r + pm) + 'h1v1h-1z';
      var tot = n + pm * 2, W = size + pad * 2;
      VT.download('<svg xmlns="http://www.w3.org/2000/svg" width="' + W + '" height="' + W + '" viewBox="0 0 ' + tot + ' ' + tot + '" shape-rendering="crispEdges"><rect width="100%" height="100%" fill="' + $('bg').value + '"/><path d="' + d + '" fill="' + $('fg').value + '"/></svg>', 'veloce-qr.svg', 'image/svg+xml');
    } catch (e) { VT.toast('SVG export is not available. Use PNG'); }
  });
  render();
})();
  </script>
</BaseLayout>
