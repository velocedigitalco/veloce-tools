---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  { q: 'When do I need to URL-encode something?', a: 'Any time a value (like a search query, email address, or special character) is being placed into a URL\'s query string or path, where characters like spaces, &, ?, and # have special meaning and need escaping.' },
  { q: 'What does %20 mean?', a: 'It\'s the URL-encoded form of a space character. Each encoded character is a % followed by its two-digit hex code.' },
  { q: 'Is this the same as encodeURI vs encodeURIComponent?', a: 'This tool uses encodeURIComponent/decodeURIComponent, the stricter of the two, which escapes characters like &, =, and ? — exactly what you want when encoding a single query parameter value.' },
];
---
<BaseLayout
  title="Free URL Encoder & Decoder Online | Veloce Tools"
  description="Encode and decode URLs, parse a link into its parts and query parameters, or build a query string. Free, runs in your browser."
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'URL Encoder/Decoder', applicationCategory: 'BrowserApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
    { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ]}
>
  <section class="section--tight">
<div class="tool-hero">
      <span class="eyebrow">Free tool</span>
      <h1>URL Encoder, Decoder &amp; Parser</h1>
      <p>Encode or decode URLs three ways, break any link into its parts and query parameters, or build a clean query string from a list of values.</p>
    </div>

    <div class="tabs" id="mainTabs">
      <button type="button" class="active" data-t="enc">Encode / Decode</button>
      <button type="button" data-t="parse">Parse a URL</button>
      <button type="button" data-t="build">Build a query string</button>
    </div>

    <div id="mainPanes">
      <div data-pane="enc">
        <div class="opt-grid" style="max-width:640px;">
          <div class="field">
            <label>Direction</label>
            <div class="segmented" style="margin:0;">
              <label><input type="radio" name="mode" value="encode" checked><span>Encode</span></label>
              <label><input type="radio" name="mode" value="decode"><span>Decode</span></label>
            </div>
          </div>
          <div class="field">
            <label for="method">Method</label>
            <select id="method">
              <option value="component">Component (strict, best for values)</option>
              <option value="uri">Full URL (keeps : / ? &amp; =)</option>
              <option value="form">Form style (space becomes +)</option>
            </select>
          </div>
        </div>
        <label class="check"><input type="checkbox" id="perLine" /> Process each line separately</label>
        <div class="tool-columns" style="margin-top:12px;">
          <div class="field" style="margin-bottom:0;">
            <label for="in" id="inLbl">Text to encode</label>
            <textarea id="in" spellcheck="false" placeholder="Paste a URL, query value or text..." style="min-height:220px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;"></textarea>
          </div>
          <div>
            <p class="tool-label" id="outLbl">Encoded result</p>
            <div class="out mono" id="out" style="min-height:220px;"></div>
            <div class="actions">
              <button type="button" class="mini dark" data-copy="#out">Copy result</button>
              <button type="button" class="mini" id="swap">Swap input and output</button>
              <button type="button" class="mini" id="clr">Clear</button>
            </div>
          </div>
        </div>
      </div>

      <div data-pane="parse" class="hidden">
        <div class="field"><label for="pin">URL to parse</label>
          <input id="pin" type="text" placeholder="https://user@example.com:8080/path/page?utm_source=news&amp;id=42#section" /></div>
        <div class="actions" style="margin-top:0;"><button type="button" class="mini" id="pSample">Load example</button></div>
        <div class="tool-columns" style="margin-top:12px;">
          <div><p class="tool-label">Parts</p><div class="panel" id="parts" style="padding:8px 18px;"><p class="hint">Enter a URL above.</p></div></div>
          <div><p class="tool-label">Query parameters</p><div class="panel" id="params" style="padding:8px 18px;"><p class="hint">No parameters yet.</p></div></div>
        </div>
      </div>

      <div data-pane="build" class="hidden">
        <div class="tool-columns" style="margin-top:0;">
          <div>
            <div class="field"><label for="base">Base URL (optional)</label><input id="base" type="text" placeholder="https://example.com/search" /></div>
            <div class="field"><label for="kv">Parameters, one per line (key=value)</label>
              <textarea id="kv" spellcheck="false" placeholder="q=web design&#10;city=Lahore&#10;utm_source=newsletter" style="min-height:160px;font-family:ui-monospace,Menlo,monospace;font-size:13px;"></textarea></div>
            <div class="field"><label for="spc">Encode spaces as</label>
              <select id="spc"><option value="%20">%20 (standard)</option><option value="+">+ (form style)</option></select></div>
          </div>
          <div>
            <p class="tool-label">Result</p>
            <div class="out mono" id="bOut" style="min-height:120px;"></div>
            <div class="actions"><button type="button" class="mini dark" data-copy="#bOut">Copy URL</button></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight prose">
    <span class="eyebrow">Why it matters</span>
    <h2>A raw ampersand in a query string breaks the next parameter.</h2>
    <p>Building links by hand — tracking URLs, search queries, redirect targets — is one typo away from silently truncating or corrupting a parameter. Encoding properly means the receiving server reads exactly what you meant to send.</p>
  </section>

  <section class="section--tight">
    <span class="eyebrow">FAQ</span>
    <h2 style="font-size:32px; letter-spacing:-1.5px; margin-bottom:20px;">Common questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="cta">
    <h2>Setting up tracking links or redirects at scale?</h2>
    <p>Veloce Digital sets up attribution tracking and campaign links properly, end to end.</p>
    <a href="https://velocedigital.co/seo.html?utm_source=veloce_tools&utm_medium=url_encoder" target="_blank" rel="noopener" class="cta-button">See SEO Services</a>
  </section>

  <script slot="body-end" is:inline>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var mode = function () { return document.querySelector('input[name="mode"]:checked').value; };

  function enc(s, m) { var v = m === 'uri' ? encodeURI(s) : encodeURIComponent(s); return m === 'form' ? v.replace(/%20/g, '+') : v; }
  function dec(s, m) { if (m === 'form') s = s.replace(/\+/g, ' '); return m === 'uri' ? decodeURI(s) : decodeURIComponent(s); }

  function run() {
    var s = $('in').value, m = mode(), meth = $('method').value, o = $('out');
    $('inLbl').textContent = m === 'encode' ? 'Text to encode' : 'Text to decode';
    $('outLbl').textContent = m === 'encode' ? 'Encoded result' : 'Decoded result';
    o.className = 'out mono';
    if (!s) { o.textContent = ''; return; }
    try {
      var f = function (x) { return m === 'encode' ? enc(x, meth) : dec(x, meth); };
      o.textContent = $('perLine').checked ? s.split('\n').map(f).join('\n') : f(s);
    } catch (e) { o.className = 'out err'; o.textContent = 'Could not decode. The input contains an invalid percent sequence (for example a stray % sign).'; }
  }
  ['in'].forEach(function (id) { $(id).addEventListener('input', run); });
  ['method', 'perLine'].forEach(function (id) { $(id).addEventListener('change', run); });
  document.querySelectorAll('input[name="mode"]').forEach(function (r) { r.addEventListener('change', run); });
  $('clr').addEventListener('click', function () { $('in').value = ''; run(); });
  $('swap').addEventListener('click', function () {
    var res = $('out').classList.contains('err') ? '' : $('out').textContent; $('in').value = res;
    document.querySelector('input[name="mode"][value="' + (mode() === 'encode' ? 'decode' : 'encode') + '"]').checked = true; run();
  });
  VT.tabs($('mainTabs'), $('mainPanes'));

  /* parser */
  function row(label, val) {
    return '<div class="rowline"><div class="lbl">' + label + '</div><div class="val">' + (val ? VT.esc(val) : '<span style="color:#bbb">none</span>') + '</div>' +
      (val ? '<button type="button" class="mini" data-v="' + VT.esc(val) + '">Copy</button>' : '') + '</div>';
  }
  function parse() {
    var s = $('pin').value.trim();
    if (!s) { $('parts').innerHTML = '<p class="hint">Enter a URL above.</p>'; $('params').innerHTML = '<p class="hint">No parameters yet.</p>'; return; }
    var u; try { u = new URL(/^[a-z][a-z0-9+.-]*:/i.test(s) ? s : 'https://' + s); }
    catch (e) { $('parts').innerHTML = '<div class="out err" style="margin:10px 0;">That does not look like a valid URL.</div>'; $('params').innerHTML = ''; return; }
    var dp; try { dp = decodeURIComponent(u.pathname); } catch (e) { dp = u.pathname; }
    $('parts').innerHTML = row('Protocol', u.protocol.replace(':', '')) + row('Host', u.hostname) + row('Port', u.port) + row('Path', u.pathname) +
      (dp !== u.pathname ? row('Decoded path', dp) : '') + row('Query', u.search) + row('Fragment', u.hash) + row('Username', u.username) + row('Origin', u.origin);
    var ps = Array.from(u.searchParams.entries());
    $('params').innerHTML = ps.length ? ps.map(function (p) { return row(p[0], p[1]); }).join('') : '<p class="hint">This URL has no query parameters.</p>';
  }
  $('pin').addEventListener('input', VT.debounce(parse, 150));
  $('pSample').addEventListener('click', function () { $('pin').value = 'https://user@example.com:8080/caf%C3%A9/menu?utm_source=news%20letter&id=42&ref=a%26b#section-2'; parse(); });
  document.addEventListener('click', function (e) { var b = e.target.closest('[data-v]'); if (b) VT.copy(b.getAttribute('data-v')); });

  /* builder */
  function build() {
    var lines = $('kv').value.split('\n').map(function (l) { return l.trim(); }).filter(Boolean), sp = $('spc').value;
    var q = lines.map(function (l) {
      var i = l.indexOf('='); var k = i < 0 ? l : l.slice(0, i), v = i < 0 ? '' : l.slice(i + 1);
      return encodeURIComponent(k.trim()).replace(/%20/g, sp) + '=' + encodeURIComponent(v.trim()).replace(/%20/g, sp);
    }).join('&');
    var base = $('base').value.trim(); $('bOut').textContent = (base ? base + (q ? (base.indexOf('?') > -1 ? '&' : '?') : '') : (q ? '?' : '')) + q;
  }
  ['kv', 'base'].forEach(function (id) { $(id).addEventListener('input', build); }); $('spc').addEventListener('change', build);
})();
  </script>
</BaseLayout>
