---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  { q: 'What\'s the difference between PNG, JPEG, and WebP?', a: 'PNG supports transparency and is best for logos or graphics with sharp edges. JPEG is best for photos and doesn\'t support transparency. WebP usually gives the smallest file size of the three while supporting transparency too, but a few very old browsers don\'t support it.' },
  { q: 'Does converting lose quality?', a: 'Converting to JPEG or WebP uses lossy compression, so there\'s a small quality trade-off (usually invisible at 90%+ quality). Converting to PNG is lossless, so no quality is lost, but file size may increase.' },
  { q: 'Is my image uploaded anywhere?', a: 'No — the conversion happens in your browser using the Canvas API. Nothing is sent to a server.' },
];
---
<BaseLayout
  title="Free Image Converter — PNG, JPEG, WebP | Veloce Tools"
  description="Batch convert images between PNG, JPEG, WebP and AVIF, with resize, rotate and flip. Download as a ZIP. Free, runs in your browser, nothing is uploaded."
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Image Converter', applicationCategory: 'BrowserApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
    { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ]}
>
  <section class="section--tight">
<div class="tool-hero">
      <span class="eyebrow">Free tool</span>
      <h1>Image Converter</h1>
      <p>Convert between PNG, JPEG, WebP and AVIF. Batch convert, resize, rotate or flip in the same step. Nothing is uploaded.</p>
    </div>

    <div class="tool-columns">
      <div>
        <label class="dropzone" id="dz">
          <input type="file" multiple accept="image/*" />
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 16V4m0 0 5 5m-5-5-5 5M5 20h14" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="dz-title">Drop images here, click to browse, or paste with Ctrl+V</span>
          <span class="dz-sub">Batch supported &middot; PNG, JPEG, WebP, GIF, BMP, SVG</span>
        </label>

        <p class="tool-label">Convert to</p>
        <div class="chips" id="fmts">
          <button type="button" class="chip" data-f="image/png">PNG</button>
          <button type="button" class="chip active" data-f="image/jpeg">JPEG</button>
          <button type="button" class="chip" data-f="image/webp">WebP</button>
          <button type="button" class="chip hidden" id="avifChip" data-f="image/avif">AVIF</button>
        </div>

        <div class="slider-row" id="qWrap">
          <div class="slider-top"><span>Quality</span><strong id="qv">92%</strong></div>
          <input type="range" id="q" min="10" max="100" value="92" />
        </div>

        <div class="opt-grid">
          <div class="field">
            <label for="scale">Resize</label>
            <select id="scale">
              <option value="1">Original size</option>
              <option value="0.75">75%</option>
              <option value="0.5">50%</option>
              <option value="0.25">25%</option>
              <option value="w1920">Fit within 1920 px</option>
              <option value="w1280">Fit within 1280 px</option>
              <option value="w800">Fit within 800 px</option>
            </select>
          </div>
          <div class="field">
            <label for="rot">Rotate</label>
            <select id="rot">
              <option value="0">No rotation</option>
              <option value="90">90&deg; clockwise</option>
              <option value="180">180&deg;</option>
              <option value="270">90&deg; counter-clockwise</option>
            </select>
          </div>
        </div>
        <div class="toggle-group">
          <label class="toggle-chip"><input type="checkbox" id="flipH"><span>Flip horizontal</span></label>
          <label class="toggle-chip"><input type="checkbox" id="flipV"><span>Flip vertical</span></label>
        </div>

        <details class="adv">
          <summary>Background and naming</summary>
          <div>
            <label class="check"><input type="checkbox" id="fill" /> Fill transparent areas with a color</label>
            <div class="field" style="margin-top:8px;">
              <label for="bg">Fill color</label>
              <input type="color" id="bg" value="#ffffff" style="height:44px;padding:4px;" />
            </div>
            <p class="hint">JPEG has no transparency, so transparent areas are always filled (white by default).</p>
          </div>
        </details>
      </div>

      <div>
        <div id="list"><div class="out" style="color:#999;">Converted images will appear here.</div></div>
        <div class="actions" id="acts" style="display:none;">
          <button type="button" class="primary-button" id="zipBtn" style="border:none;">Download all (ZIP)</button>
          <button type="button" class="secondary-button" id="clearBtn">Clear all</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight prose">
    <span class="eyebrow">Why it matters</span>
    <h2>The right format saves bandwidth without anyone noticing.</h2>
    <p>Serving a photo as PNG when it should be JPEG (or WebP) routinely triples file size for no visual benefit. Matching format to content — WebP or JPEG for photos, PNG only when you genuinely need transparency or sharp line art — is one of the easiest wins for page speed.</p>
  </section>

  <section class="section--tight">
    <span class="eyebrow">FAQ</span>
    <h2 style="font-size:32px; letter-spacing:-1.5px; margin-bottom:20px;">Common questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="cta">
    <h2>Want your whole site optimized, not just one image?</h2>
    <p>Veloce Digital's website care plans handle image optimization, caching, and speed as an ongoing service.</p>
    <a href="https://velocedigital.co/website-care-plans.html?utm_source=veloce_tools&utm_medium=image_converter" target="_blank" rel="noopener" class="cta-button">See Care Plans</a>
  </section>

  <script slot="body-end" is:inline>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var items = [], fmt = 'image/jpeg', token = 0;

  try { if (document.createElement('canvas').toDataURL('image/avif').indexOf('image/avif') === 5) $('avifChip').classList.remove('hidden'); } catch (e) {}

  function opts() {
    var sc = $('scale').value, o = { fmt: fmt, q: Number($('q').value) / 100, rotate: Number($('rot').value),
      flipH: $('flipH').checked, flipV: $('flipV').checked, fill: $('fill').checked, bg: $('bg').value };
    if (sc.charAt(0) === 'w') o.max = Number(sc.slice(1)); else o.scale = Number(sc);
    return o;
  }
  function syncQ() { $('qWrap').style.display = fmt === 'image/png' ? 'none' : ''; }

  document.querySelectorAll('#fmts .chip').forEach(function (b) {
    b.addEventListener('click', function () {
      fmt = b.getAttribute('data-f');
      document.querySelectorAll('#fmts .chip').forEach(function (x) { x.classList.toggle('active', x === b); });
      syncQ(); run();
    });
  });
  $('q').addEventListener('input', function () { $('qv').textContent = $('q').value + '%'; run(); });
  ['scale', 'rot', 'flipH', 'flipV', 'fill', 'bg'].forEach(function (id) { $(id).addEventListener('change', function () { run(); }); });
  $('bg').addEventListener('input', function () { run(); });

  function addFiles(files) {
    files = files.filter(function (f) { return f.type.indexOf('image/') === 0; });
    if (!files.length) { VT.toast('Please choose image files'); return; }
    Promise.all(files.map(function (f) {
      return VT.loadImage(f).then(function (r) { return { file: f, img: r.img, url: r.url, res: null }; }).catch(function () { VT.toast('Could not read ' + f.name); return null; });
    })).then(function (list) { list.filter(Boolean).forEach(function (it) { items.push(it); }); run(); });
  }
  VT.drop($('dz'), addFiles, { paste: true, accept: 'image/' });

  function outName(it) { return it.file.name.replace(/\.[^.]+$/, '') + '.' + VT.EXT[fmt]; }

  var run = VT.debounce(function () {
    var my = ++token, o = opts();
    if (!items.length) { render(); return; }
    Promise.all(items.map(function (it) { return VT.processImage(it.img, o).then(function (r) { if (my === token) it.res = r; }); }))
      .then(function () { if (my === token) render(); });
  }, 120);

  function render() {
    var list = $('list');
    if (!items.length) { list.innerHTML = '<div class="out" style="color:#999;">Converted images will appear here.</div>'; $('acts').style.display = 'none'; return; }
    list.innerHTML = '';
    items.forEach(function (it, i) {
      if (!it.res) return;
      var ext = it.file.type.split('/')[1] || 'img';
      var div = document.createElement('div'); div.className = 'file-item';
      div.innerHTML = '<img src="' + it.url + '" alt="" />' +
        '<div><div class="nm">' + VT.esc(outName(it)) + '</div><div class="sub">' + ext.toUpperCase() + ' ' + VT.bytes(it.file.size) + ' &rarr; ' +
        VT.EXT[fmt].toUpperCase() + ' ' + VT.bytes(it.res.blob.size) + ' &middot; ' + it.res.w + '&times;' + it.res.h + '</div></div>' +
        '<div class="btn-row" style="margin:0;"><button class="mini dark" data-dl="' + i + '">Download</button><button class="mini" data-rm="' + i + '">Remove</button></div>';
      list.appendChild(div);
    });
    $('acts').style.display = 'flex';
    $('zipBtn').style.display = items.length > 1 ? '' : 'none';
  }

  $('list').addEventListener('click', function (e) {
    var d = e.target.closest('[data-dl]'), r = e.target.closest('[data-rm]');
    if (d) { var it = items[Number(d.getAttribute('data-dl'))]; VT.download(it.res.blob, outName(it)); }
    if (r) { var gone = items.splice(Number(r.getAttribute('data-rm')), 1)[0]; URL.revokeObjectURL(gone.url); render(); }
  });
  $('zipBtn').addEventListener('click', function () {
    var seen = {};
    VT.zipBlobs(items.map(function (it) {
      var n = outName(it); if (seen[n]) n = n.replace(/(\.[^.]+)$/, '-' + seen[n]++ + '$1'); else seen[n] = 1;
      return { name: n, blob: it.res.blob };
    })).then(function (z) { VT.download(z, 'veloce-converted-images.zip'); });
  });
  $('clearBtn').addEventListener('click', function () { items.forEach(function (i) { URL.revokeObjectURL(i.url); }); items = []; render(); });
  syncQ();
})();
  </script>
</BaseLayout>
